<RadzenDataGrid @ref="grid"
                AllowFiltering="false"
                AllowSorting="true"
                AllowColumnResize="false"
                Data="@exerciceList"
                LoadData="LoadDatas"
                TItem="ViewModels.Exercice"
                ColumnWidth="100px"
                GridLines="DataGridGridLines.Both"
                FilterMode="FilterMode.Simple"
                SelectionMode="DataGridSelectionMode.Single"
                @bind-Value="@selectedRow"
                Style="height:400px;">
    <Columns>
        <RadzenDataGridColumn TItem="ViewModels.Exercice" Property="RowIndex" Title="#" Width="30px" SortOrder="SortOrder.Ascending">
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ViewModels.Exercice" Property="Code" Title="Code">
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ViewModels.Exercice" Property="Label" Title="Description" Width="160px">
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

<div class="row mt-2 dialog-btns justify-content-end">
    <div class="col-auto">
        <RadzenButton ButtonStyle="ButtonStyle.Info" Icon="cancel" Text="Annuler" Click="@((args) => DialogService.Close())" />
    </div>
    <div class="col-auto">
        <RadzenButton ButtonType="ButtonType.Submit" Icon="add_circle" Text="Creer" Click="@Select" Disabled="@(selectedRow?.Count != 1)" />
    </div>
</div>