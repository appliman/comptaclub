<span class="filesize">@SmartFileSize</span>

@code {

    [Parameter]
    public long FileSize { get; set; }

    public string SmartFileSize
    {
        get
        {
            var units = new[] { "o", "Ko", "Mo", "Go", "To" };
            var index = 0;
            var size = Convert.ToDouble(FileSize);
            while (size > 1024)
            {
                size /= 1024d;
                index++;
            }
            return string.Format("{0:F2} {1}", size, units[index]);
        }
    }
}
