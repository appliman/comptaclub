<h3>EditAccount</h3>

<EditForm Model="account" OnValidSubmit="ValidateAndSave">
	<ValidationSummary></ValidationSummary>
	<DataAnnotationsValidator />
	<CustomValidator @ref="customValidator"></CustomValidator>
	<div class="mb-3">
		<SuperInputText @bind-Value="account.Code" Label="Code" PlaceHoder="123456"></SuperInputText>
	</div>
	<div class="mb-3">
		<SuperInputText @bind-Value="account.Label" Label="Libellé" PlaceHoder="Nom du compte"></SuperInputText>
	</div>
	<input type="submit" value="Sauvegarder" class="btn btn-primary">
</EditForm>


