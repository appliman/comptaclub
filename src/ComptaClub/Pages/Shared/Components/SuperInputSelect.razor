@typeparam T 

<div class="form-group">
	<label class="control-label">@Label</label>
	<div>
		<InputSelect TValue="T" class="form-select" Value="Value" ValueChanged="ValueChanged" ValueExpression="ValueExpression">
			@foreach(var item in ItemList!)
			{
				<option value="@item.Value" selected="@item.Selected">@item.Text</option>
			}
		</InputSelect>
		<ValidationMessage For="() => Value"></ValidationMessage>
	</div>
</div>


@code {
	[Parameter]
	public string? Label { get; set; }

	[Parameter]
	public T Value { get; set; } = default(T)!;

	[Parameter]
	public EventCallback<T> ValueChanged { get; set; }

	[Parameter]
	public System.Linq.Expressions.Expression<Func<T>>? ValueExpression { get; set; }

	[Parameter]
	public bool Required { get; set; }

	[Parameter]
	public RenderFragment? ChildContent { get; set; }

	[Parameter]
	public IEnumerable<ViewModels.SelectOption<T>>? ItemList { get; set; }

}
