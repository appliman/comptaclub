<div class="form-group">
	<label for="Name" class="control-label">@Label</label>
	<div>
		<InputTextArea @attributes="@CatpuredAttributes" type="@Type" class="form-control" Value="@Value" placeholder="@PlaceHoder" required="@(Required ? "required" : null)" ValueChanged="@ValueChanged" ValueExpression="@ValueExpression"  />
		<small>
			<ValidationMessage For="@ValueExpression" />
		</small>
		@ChildContent
	</div>
</div>

@code {

	[Parameter]
	public string Label { get; set; }

	[Parameter]
	public string Value  { get; set; }

	[Parameter]
	public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public System.Linq.Expressions.Expression<Func<string>> ValueExpression { get; set; }

	[Parameter]
	public string PlaceHoder { get; set; }

	[Parameter]
	public bool Required { get; set; }

	[Parameter]
	public string Type { get; set; } = "text";

	[Parameter]
	public RenderFragment ChildContent { get; set; }

	[Parameter(CaptureUnmatchedValues = true)]
	public Dictionary<string, object> CatpuredAttributes { get; set; } = new();

}
