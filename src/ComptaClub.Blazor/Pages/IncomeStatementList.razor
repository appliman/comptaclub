@page "/comptes-resultats"

<PageTitle>Les comptes de résulat</PageTitle>

<SectionContent SectionName="toolbar">

    <SuperButton Text="Ajouter"
                  Click="CreateIncomeStatement"
                  Icon="fa-circle-plus"
                  Style="SuperButtonStyle.Success"
                  class="btn btn-primary m-1"
                  title="Creer un compte de résultat" />

</SectionContent>

<SuperDataGrid RowHeight="55" @ref="grid" DisplaySelectionColumn="false" DisplayColumnVisibilityToggle="false"
    AllowFiltering="false"
    AllowSorting="true"
    AllowColumnResize="true"
    ItemsProvider="LoadItems"

    TItem="ViewModels.IncomeStatement"
 SelectionMode="SuperDataGridSelectionMode.None" DisplayRowNumberColumn="false"


    Height="500px" ActionsWidth="70">
        <ActionsTemplate Context="incomeStatement">
            <SuperButton Icon="fa-trash" Style="SuperButtonStyle.Warning"  Size="SuperButtonSize.Default" Click="@(args => DeleteRow(incomeStatement))" @onclick:stopPropagation="true" title="Supprimer ce compte de résultat">
            </SuperButton>
        </ActionsTemplate>
        <ChildContent>
        <DataGridColumn TItem="ViewModels.IncomeStatement" Property="Description" Title="Description" Filterable="false">
            <Template Context="data">
                <a href="/compte-de-resultat/@data.Id">@data.Description</a>
            </Template>
        </DataGridColumn>
        <DataGridColumn TItem="ViewModels.IncomeStatement" Property="CreationDate" Title="Date" Filterable="false" Width="150px">
            <Template Context="data">
                <DateIdLabel Value="data.CreationDate" />
            </Template>
        </DataGridColumn>
        <DataGridColumn TItem="ViewModels.IncomeStatement" Title="Crédit" Width="120px" Filterable="false">
            <Template Context="data">
                <PriceLabel Value="data.CreditTotal"/>
            </Template>
        </DataGridColumn>
        <DataGridColumn TItem="ViewModels.IncomeStatement" Title="Débit" Width="120px" Filterable="false">
            <Template Context="data">
                <PriceLabel Value="data.DebitTotal" />
            </Template>
        </DataGridColumn>
        <DataGridColumn TItem="ViewModels.IncomeStatement" Title="Résultat Net" Width="120px" Filterable="false">
            <Template Context="data">
                @{
                    var total = data.CreditTotal - data.DebitTotal;
                }
                <PriceLabel Value="@total" />
            </Template>
        </DataGridColumn>
        </ChildContent>
</SuperDataGrid>
