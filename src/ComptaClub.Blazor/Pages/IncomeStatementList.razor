@page "/comptes-resultats"

<PageTitle>Les comptes de résulat</PageTitle>

<RadzenDataGrid @ref="grid" 
    AllowFiltering="true" 
    AllowSorting="true" 
    AllowColumnResize="true"
    Data="@incomeStatementList"
    LoadData="@LoadDatas"
    TItem="ViewModels.IncomeStatement"
    SelectionMode="DataGridSelectionMode.Single"
    AllowRowSelectOnRowClick="true"
    ColumnWidth="80px"
    @bind-Value="selectedRow">
    <Columns>
        <RadzenDataGridColumn TItem="ViewModels.IncomeStatement" Property="Description" Title="Description" Width="120px" Filterable="false">
            <Template Context="data">
                <a href="/compte-de-resultat/@data.Id">@data.Description</a>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ViewModels.IncomeStatement" Title="Crédit" Width="120px" Filterable="false">
            <Template Context="data">
                <PriceLabel Value="data.CreditTotal"/>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ViewModels.IncomeStatement" Title="Débit" Width="120px" Filterable="false">
            <Template Context="data">
                <PriceLabel Value="data.DebitTotal" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ViewModels.IncomeStatement" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Width="156px">
            <Template Context="incomeStatement">
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Warning" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@(args => DeleteRow(incomeStatement))" @onclick:stopPropagation="true" title="Supprimer cet compte de résultat">
                </RadzenButton>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>