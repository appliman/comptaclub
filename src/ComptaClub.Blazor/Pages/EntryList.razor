@page "/ecritures"

<PageTitle>Ecritures</PageTitle>

<RadzenDataGrid @ref="grid" 
    AllowFiltering="true" 
    AllowSorting="false" 
    AllowColumnResize="true"
    Data="@entryList"
    LoadData="@LoadDatas"
    TItem="ViewModels.Entry"
    ColumnWidth="90px"
    GridLines="DataGridGridLines.Both" 
    FilterMode="FilterMode.Simple">
    <Columns>
        <RadzenDataGridColumn TItem="ViewModels.Entry" Property="RowIndex" Title="#" Width="50px" Filterable="false" FormatString="" Frozen="true" SortOrder="SortOrder.Ascending">
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ViewModels.Entry" Property="CreationDate" Title="Date" Width="150px" Filterable="true" Frozen="true">
            <FilterTemplate>
                <SuperPeriodFilterInputSelect @bind-Value="selectedPeriodFilter" ExerciceId="activeExercice.Id" ApplyFilter="ApplyFilter" />
            </FilterTemplate>
            <Template Context="data">
                <DateLabel Value="data.CreationDate" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ViewModels.Entry" Property="PartNumber" Title="N°" Width="250px" Filterable="true" Frozen="true">
            <Template Context="data">
                <div class="w-100">
                    @data.PartNumber<br/>
                    @data.Label<br/>
                    <small>@data.ExtraInfos</small>
                </div>
            </Template>
            <FooterTemplate>
                @if (entryList != null)
                {
                    <div>Nombre d'ecritures : @entryList!.Count() / @entryList!.Count()</div>
                }
            </FooterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ViewModels.Entry" Property="AccountId" Title="Compte" Width="250px" Filterable="true">
            <FilterTemplate>
                <RadzenDropDown @bind-Value="filter.AccountIdList" 
                    Multiple="true" 
                    AllowSelectAll="false"
                    Data="@leafAccountList"
                    TextProperty="CodeAndLabel" 
                    ValueProperty="Id"
                    Change="ApplyFilter"
                    Style="width:100%"
                    />
            </FilterTemplate>
            <Template Context="data">
                <div class="w-100">@leafAccountList.SingleOrDefault(i => data.AccountId == i.Id)?.CodeAndLabel</div>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ViewModels.Entry" Property="PaymentType" Title="Règlement" Filterable="true" Width="120px">
            <FilterTemplate>
                <SuperNullableEnumDropdownFilterColumn @bind-Value="@filter.PaymentType" ApplyFilter="ApplyFilter" />
            </FilterTemplate>
            <Template Context="entry">
                <EnumLabel Value="@entry.PaymentType"/>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ViewModels.Entry" Title="Débit" Filterable="true">
            <FilterTemplate>
                <AmountColumnFilter @bind-AmountFilter="filter.DebitAmountFilter" Title="Débit" ApplyFilter="ApplyFilter" />
            </FilterTemplate>
            <Template Context="entry">
                @if (entry.AccountDirection == Enums.AccountDirection.Debit)
                {
                    <PriceLabel Value="@entry.Amount" />
                }
            </Template>
            <FooterTemplate>
                @if (entryList != null) 
                {
                    <PriceLabel Value="@(entryList!.Where(i => i.AccountDirection == Enums.AccountDirection.Debit).Sum(i => i.Amount))" />
                }
            </FooterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ViewModels.Entry" Title="Crédit" Filterable="true">
            <FilterTemplate>
                <AmountColumnFilter @bind-AmountFilter="filter.CreditAmountFilter" Title="Crédit" ApplyFilter="ApplyFilter" />
            </FilterTemplate>
            <Template Context="entry">
                @if (entry.AccountDirection == Enums.AccountDirection.Credit)
                {
                    <PriceLabel Value="@entry.Amount" />
                }
            </Template>
            <FooterTemplate>
                @if (entryList != null)
                {
                    <PriceLabel Value="@(entryList!.Where(i => i.AccountDirection == Enums.AccountDirection.Credit).Sum(i => i.Amount))" />
                }
            </FooterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ViewModels.Entry" Title="Solde" Filterable="true">
            <FilterTemplate>
                <AmountColumnFilter @bind-AmountFilter="filter.BalanceAmountFilter" Title="Solde" ApplyFilter="ApplyFilter" />
            </FilterTemplate>
            <Template Context="entry">
                <PriceLabel Value="@entry.Balance" />
            </Template>
            <FooterTemplate>
                <PriceLabel Value="@currentBalance"/>
            </FooterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ViewModels.Entry" Context="entry" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Width="100px">
            <Template Context="entry">
                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@(args => EditRow(entry))" @onclick:stopPropagation="true" title="Editer cette ecriture">
                </RadzenButton>
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Warning" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@(args => DeleteRow(entry))" @onclick:stopPropagation="true" title="Supprimer cette ecriture">
                </RadzenButton>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>