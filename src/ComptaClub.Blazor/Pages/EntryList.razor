@page "/ecritures"

@layout ListMainLayout

<SectionContent SectionName="toolbar">
	<SuperButton Text="Dépense"
				  Click="@(() => InsertRow("charge"))"
				  Icon="fa-circle-plus"
				  Style="SuperButtonStyle.Success"
				  class="btn btn-primary m-1"
				  title="Ajouter une dépense" />

	<SuperButton Text="Rentrée"
				  Click="@(() => InsertRow("produit"))"
				  Icon="fa-circle-plus"
				  Style="SuperButtonStyle.Success"
				  class="btn btn-primary m-1"
				  title="Ajouter une rentrée" />

	<SuperLinkButton Text="Import"
				Href="/importation-ecritures"
				Icon="fa-cloud-arrow-up"
				class="btn btn-primary m-1"
				title="Importer" />

</SectionContent>

<SectionContent SectionName="EntityContext">
	<EntityContext @ref="entityContext" />
</SectionContent>

<PageTitle>Ecritures</PageTitle>
<div style="height:100%">
	<SuperDataGrid RowHeight="55" @ref="grid" DisplaySelectionColumn="false" DisplayColumnVisibilityToggle="false"
					AllowFiltering="true"
					AllowSorting="false"
					AllowColumnResize="true"
					ItemsProvider="LoadItems"

					TItem="ViewModels.EntryRow"

					DisplayRowNumberColumn="true"
					Height="500px"
					RowClicked="RowSelected" ActionsWidth="120">
			<ActionsTemplate Context="entry">
				<SuperButton Icon="fa-trash" Style="SuperButtonStyle.Warning" Size="SuperButtonSize.Default" Click="@(args => DeleteRow(entry))" title="Supprimer cette écriture" />
				<SuperLinkButton Icon="fa-pen" Style="SuperButtonStyle.Light" Size="SuperButtonSize.Default" Href="@GetEditUrl(entry)" title="Éditer cette écriture" aria-label="Éditer cette écriture" />
			</ActionsTemplate>
			<ChildContent>
			<DataGridColumn TItem="ViewModels.EntryRow" Property="CreationDate" Title="Date" Width="150px" Filterable="true" >
				<FilterTemplate>
					<SuperPeriodFilterInputSelect @bind-Value="selectedPeriodFilter" ExerciceId="activeExercice.Id" ApplyFilter="ApplyFilter" />
				</FilterTemplate>
				<Template Context="data">
					<DateIdLabel Value="data.Entity.CreationDate" />
				</Template>
			</DataGridColumn>
			<DataGridColumn TItem="ViewModels.EntryRow" Property="PartNumber" Title="N°" Filterable="true" >
				<Template Context="data">
					<div class="w-100">
						@data.Entity.PartNumber<br />
						@data.Entity.Label<br />
						<small>@data.Entity.ExtraInfos</small>
					</div>
				</Template>
				<FooterTemplate>
					@if (entryList != null)
					{
						<div>Nombre d'ecritures : @entryList!.Count() / @entryList!.Count()</div>
					}
				</FooterTemplate>
			</DataGridColumn>
			<DataGridColumn TItem="ViewModels.EntryRow" Property="AccountId" Title="Compte" Width="250px" Filterable="true">
				<FilterTemplate>
					<AccountColumnFilter Accounts="leafAccountList" @bind-Value="filter.AccountIdList" ApplyFilter="ApplyFilter" />
				</FilterTemplate>
				<Template Context="data">
					<div class="w-100">@leafAccountList.SingleOrDefault(i => data.Entity.AccountId == i.Id)?.CodeAndLabel</div>
				</Template>
			</DataGridColumn>
			<DataGridColumn TItem="ViewModels.EntryRow" Property="PaymentType" Title="Règlement" Filterable="true" Width="140px">
				<FilterTemplate>
					<SuperNullableEnumDropdownFilterColumn @bind-Value="@filter.PaymentType" ApplyFilter="ApplyFilter" />
				</FilterTemplate>
				<Template Context="entry">
					<EnumLabel Value="@entry.Entity.PaymentType" />
				</Template>
				<FooterTemplate>
					<PriceLabel Prefix="R.Net : " Value="GetProfit()" Color="blue" />
				</FooterTemplate>
			</DataGridColumn>
			<DataGridColumn TItem="ViewModels.EntryRow" Title="Débit" Filterable="true" Width="150px">
				<FilterTemplate>
					<AmountColumnFilter @bind-AmountFilter="filter.DebitAmountFilter" Title="Débit" ApplyFilter="ApplyFilter" />
				</FilterTemplate>
				<Template Context="entry">
					@if (entry.Entity.AccountDirection == Enums.AccountDirection.Debit)
					{
						<PriceLabel Value="@entry.Entity.Amount" />
					}
				</Template>
				<FooterTemplate>
					@if (entryList != null)
					{
						<PriceLabel Value="@(entryList!.Where(i => i.Entity.AccountDirection == Enums.AccountDirection.Debit).Sum(i => i.Entity.Amount))" />
					}
				</FooterTemplate>
			</DataGridColumn>
			<DataGridColumn TItem="ViewModels.EntryRow" Title="Crédit" Filterable="true" Width="150px">
				<FilterTemplate>
					<AmountColumnFilter @bind-AmountFilter="filter.CreditAmountFilter" Title="Crédit" ApplyFilter="ApplyFilter" />
				</FilterTemplate>
				<Template Context="entry">
					@if (entry.Entity.AccountDirection == Enums.AccountDirection.Credit)
					{
						<PriceLabel Value="@entry.Entity.Amount" />
					}
				</Template>
				<FooterTemplate>
					@if (entryList != null)
					{
						<PriceLabel Value="@(entryList!.Where(i => i.Entity.AccountDirection == Enums.AccountDirection.Credit).Sum(i => i.Entity.Amount))" />
					}
				</FooterTemplate>
			</DataGridColumn>
			<DataGridColumn TItem="ViewModels.EntryRow" Title="Solde" Filterable="true" Width="150px">
				<FilterTemplate>
					<AmountColumnFilter @bind-AmountFilter="filter.BalanceAmountFilter" Title="Solde" ApplyFilter="ApplyFilter" />
				</FilterTemplate>
				<Template Context="entry">
					<PriceLabel Value="@entry.Entity.Balance" />
				</Template>
				<FooterTemplate>
					<PriceLabel Value="@currentBalance" />
				</FooterTemplate>
			</DataGridColumn>
			</ChildContent>
	</SuperDataGrid>
</div>
