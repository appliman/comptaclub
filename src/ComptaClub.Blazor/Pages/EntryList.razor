@page "/ecritures"

<PageTitle>Ecritures</PageTitle>

<RadzenButton ButtonStyle="ButtonStyle.Success" Icon="add_circle_outline" Class="mt-2 mb-4" Text="Ajouter une dépense" Click="@(() => InsertRow("charge"))" />
<RadzenButton ButtonStyle="ButtonStyle.Success" Icon="add_circle_outline" Class="mt-2 mb-4" Text="Ajouter une rentrée" Click="@(() => InsertRow("produit"))" />
<RadzenButton ButtonStyle="ButtonStyle.Success" Icon="add_circle_outline" Class="mt-2 mb-4" Text="Import" Click="Import" />

<RadzenDataGrid @ref="grid" 
    AllowFiltering="true" 
    AllowSorting="true" 
    AllowColumnResize="true"
    Data="@entryList"
    LoadData="@LoadDatas"
    TItem="ViewModels.Entry"
    ColumnWidth="300px">
    <Columns>
        <RadzenDataGridColumn TItem="ViewModels.Entry" Property="RowIndex" Title="#" Width="60px" Filterable="false" FormatString="">
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ViewModels.Entry" Property="CreationDate" Title="Date" Width="100px" Filterable="false" FormatString="{0:dd/MM/yy}">
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ViewModels.Entry" Property="PartNumber" Title="N°" Width="180px" Filterable="false">
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ViewModels.Entry" Property="Label" Title="Libellé" Width="180px" Filterable="false">
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ViewModels.Entry" Title="Banque">
            <Columns>
                <RadzenDataGridColumn TItem="ViewModels.Entry" Title="Débit" Width="90px" Filterable="false">
                    <Template Context="entry">
                        @if (entry.AccountDirection == Datas.AccountDirection.Debit)
                        {
                            <PriceLabel Value="@entry.Amount" />
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ViewModels.Entry" Title="Crédit" Width="90px" Filterable="false">
                    <Template Context="entry">
                        @if (entry.AccountDirection == Datas.AccountDirection.Credit)
                        {
                            <PriceLabel Value="@entry.Amount" />
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ViewModels.Entry" Title="Solde" Width="90px" Filterable="false">
                    <Template Context="entry">
                        <PriceLabel Value="@entry.Balance" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ViewModels.Entry" Title="Crédit">
            <Columns>
                @foreach (var item in creditAccountOptionList)
                {
                    <RadzenDataGridColumn TItem="ViewModels.Entry" Width="90px" Filterable="false">
                        <HeaderTemplate>
                            @item.Code<br />
                            @item.Label
                        </HeaderTemplate>
                        <Template Context="entry">
                            @if (item.Id == entry.AccountId)
                            {
                                <PriceLabel Value="@entry.Amount" />
                            }
                        </Template>
                    </RadzenDataGridColumn>
                }
            </Columns>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ViewModels.Entry" Title="Debit">
            <Columns>
                @foreach (var item in debitAccountOptionList)
                {
                    <RadzenDataGridColumn TItem="ViewModels.Entry" Width="90px" Filterable="false">
                        <HeaderTemplate>
                            @item.Code<br/>
                            @item.Label
                        </HeaderTemplate>
                        <Template Context="entry">
                            @if (item.Id == entry.AccountId)
                            {
                                <PriceLabel Value="@entry.Amount" />
                            }
                        </Template>
                    </RadzenDataGridColumn>
                }
            </Columns>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ViewModels.Entry" Context="entry" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Width="156px">
            <Template Context="entry">
                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@(args => EditRow(entry))" @onclick:stopPropagation="true" title="Editer cette ecriture">
                </RadzenButton>
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Warning" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@(args => DeleteRow(entry))" @onclick:stopPropagation="true" title="Supprimer cette ecriture">
                </RadzenButton>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>