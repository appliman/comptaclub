@page "/ecritures"

<PageTitle>Ecritures</PageTitle>
<div style="height:100%">
	<RadzenDataGrid @ref="grid"
					AllowFiltering="true"
					AllowSorting="false"
					AllowColumnResize="true"
					Data="@entryList"
					LoadData="@LoadDatas"
					TItem="ViewModels.EntryRow"
					GridLines="DataGridGridLines.Both"
					FilterMode="FilterMode.Simple"
					Style="height:100%">
		<Columns>
			<RadzenDataGridColumn TItem="ViewModels.EntryRow" Property="RowIndex" Title="#" Width="60px" Filterable="false" FormatString="" Frozen="true" SortOrder="SortOrder.Ascending">
			</RadzenDataGridColumn>
			<RadzenDataGridColumn TItem="ViewModels.EntryRow" Context="entry" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Width="100px" Frozen="true">
				<Template Context="entry">
					<RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Warning" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@(args => DeleteRow(entry))" @onclick:stopPropagation="true" title="Supprimer cette ecriture">
					</RadzenButton>
					<RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@(args => EditRow(entry))" @onclick:stopPropagation="true" title="Editer cette ecriture">
					</RadzenButton>
				</Template>
			</RadzenDataGridColumn>
			<RadzenDataGridColumn TItem="ViewModels.EntryRow" Property="CreationDate" Title="Date" Width="150px" Filterable="true" Frozen="true">
				<FilterTemplate>
					<SuperPeriodFilterInputSelect @bind-Value="selectedPeriodFilter" ExerciceId="activeExercice.Id" ApplyFilter="ApplyFilter" />
				</FilterTemplate>
				<Template Context="data">
					<DateIdLabel Value="data.Entity.CreationDate" />
				</Template>
			</RadzenDataGridColumn>
			<RadzenDataGridColumn TItem="ViewModels.EntryRow" Property="PartNumber" Title="N°" Filterable="true" Frozen="true">
				<Template Context="data">
					<div class="w-100">
						@data.Entity.PartNumber<br />
						@data.Entity.Label<br />
						<small>@data.Entity.ExtraInfos</small>
					</div>
				</Template>
				<FooterTemplate>
					@if (entryList != null)
					{
						<div>Nombre d'ecritures : @entryList!.Count() / @entryList!.Count()</div>
					}
				</FooterTemplate>
			</RadzenDataGridColumn>
			<RadzenDataGridColumn TItem="ViewModels.EntryRow" Property="AccountId" Title="Compte" Width="250px" Filterable="true">
				<FilterTemplate>
					<RadzenDropDown @bind-Value="filter.AccountIdList"
									Multiple="true"
									AllowSelectAll="false"
									Data="@leafAccountList"
									TextProperty="CodeAndLabel"
									ValueProperty="Id"
									Change="ApplyFilter"
									Style="width:100%" />
				</FilterTemplate>
				<Template Context="data">
					<div class="w-100">@leafAccountList.SingleOrDefault(i => data.Entity.AccountId == i.Id)?.CodeAndLabel</div>
				</Template>
			</RadzenDataGridColumn>
			<RadzenDataGridColumn TItem="ViewModels.EntryRow" Property="PaymentType" Title="Règlement" Filterable="true" Width="140px">
				<FilterTemplate>
					<SuperNullableEnumDropdownFilterColumn @bind-Value="@filter.PaymentType" ApplyFilter="ApplyFilter" />
				</FilterTemplate>
				<Template Context="entry">
					<EnumLabel Value="@entry.Entity.PaymentType" />
				</Template>
				<FooterTemplate>
					<PriceLabel Prefix="R.Net : " Value="GetProfit()" Color="blue" />
				</FooterTemplate>
			</RadzenDataGridColumn>
			<RadzenDataGridColumn TItem="ViewModels.EntryRow" Title="Débit" Filterable="true" Width="150px">
				<FilterTemplate>
					<AmountColumnFilter @bind-AmountFilter="filter.DebitAmountFilter" Title="Débit" ApplyFilter="ApplyFilter" />
				</FilterTemplate>
				<Template Context="entry">
					@if (entry.Entity.AccountDirection == Enums.AccountDirection.Debit)
					{
						<PriceLabel Value="@entry.Entity.Amount" />
					}
				</Template>
				<FooterTemplate>
					@if (entryList != null)
					{
						<PriceLabel Value="@(entryList!.Where(i => i.Entity.AccountDirection == Enums.AccountDirection.Debit).Sum(i => i.Entity.Amount))" />
					}
				</FooterTemplate>
			</RadzenDataGridColumn>
			<RadzenDataGridColumn TItem="ViewModels.EntryRow" Title="Crédit" Filterable="true" Width="150px">
				<FilterTemplate>
					<AmountColumnFilter @bind-AmountFilter="filter.CreditAmountFilter" Title="Crédit" ApplyFilter="ApplyFilter" />
				</FilterTemplate>
				<Template Context="entry">
					@if (entry.Entity.AccountDirection == Enums.AccountDirection.Credit)
					{
						<PriceLabel Value="@entry.Entity.Amount" />
					}
				</Template>
				<FooterTemplate>
					@if (entryList != null)
					{
						<PriceLabel Value="@(entryList!.Where(i => i.Entity.AccountDirection == Enums.AccountDirection.Credit).Sum(i => i.Entity.Amount))" />
					}
				</FooterTemplate>
			</RadzenDataGridColumn>
			<RadzenDataGridColumn TItem="ViewModels.EntryRow" Title="Solde" Filterable="true" Width="150px">
				<FilterTemplate>
					<AmountColumnFilter @bind-AmountFilter="filter.BalanceAmountFilter" Title="Solde" ApplyFilter="ApplyFilter" />
				</FilterTemplate>
				<Template Context="entry">
					<PriceLabel Value="@entry.Entity.Balance" />
				</Template>
				<FooterTemplate>
					<PriceLabel Value="@currentBalance" />
				</FooterTemplate>
			</RadzenDataGridColumn>
		</Columns>
	</RadzenDataGrid>
</div>