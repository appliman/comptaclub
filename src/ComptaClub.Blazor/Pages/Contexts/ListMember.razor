@using ComptaClub.Blazor.Services
@using ComptaClub.Blazor.ViewModels

@attribute [EntityContextAttribute(MetaEntity = MetaEntity.Entry,
	Title = "Membre",
	Icon = "fa-user")]

@inherits AssociatedMemberByEntry

@code {

    [Parameter]
    public ContextInfo ContextInfo { get; set; } = default!;

    protected override async Task OnParametersSetAsync()
    {
        EntryId = ContextInfo.SelectedEntity.Id;
        if (grid is not null)
        {
            await ReloadItems();
        }
    }
}

<SectionContent SectionName="toolbar-context">
    <SuperButton Text="Associer"
                  Click="InsertRow"
                  Icon="fa-user-plus"
                  Style="SuperButtonStyle.Success"
                  class="btn btn-primary m-1"
                  title="Associer un membre à cette écriture" />
</SectionContent>


<SuperDataGrid RowHeight="55" @ref="grid" DisplaySelectionColumn="false" DisplayColumnVisibilityToggle="false"
                AllowFiltering="false"
                AllowSorting="false"
                AllowColumnResize="true"
                ItemsProvider="LoadItems"

                TItem="ViewModels.AssociatedMemberToEntryRow"

                DisplayRowNumberColumn="false" Height="400px" ActionsWidth="120">
        <ActionsTemplate Context="member">
            @if (grid.IsRowInEditMode(member))
            {
                <SuperButton Icon="fa-check" Style="SuperButtonStyle.Success"  Size="SuperButtonSize.Default" Click="@((args) => Save(member))">
                </SuperButton>
                <SuperButton Icon="fa-xmark" Style="SuperButtonStyle.Light"  Size="SuperButtonSize.Default" Class="my-1 ms-1" Click="@((args) => CancelEdit(member))">
                </SuperButton>
            }
            else
            {
                <SuperButton Icon="fa-trash" Style="SuperButtonStyle.Warning"  Size="SuperButtonSize.Default" Click="@(args => DeleteRow(member))" @onclick:stopPropagation="true" title="Supprimer cette liaison">
                </SuperButton>
                <SuperButton Icon="fa-pen" Style="SuperButtonStyle.Light"  Size="SuperButtonSize.Default" Click="@(args => EditRow(member))" @onclick:stopPropagation="true" title="Modifier cette liaison">
                </SuperButton>
            }
        </ActionsTemplate>
        <ChildContent>
        <DataGridColumn TItem="ViewModels.AssociatedMemberToEntryRow" Property="Name" Title="Nom" Filterable="false" >
            <Template Context="data">
                <span>@data.Member.Entity.Name</span>
            </Template>
        </DataGridColumn>
        <DataGridColumn TItem="ViewModels.AssociatedMemberToEntryRow" Property="Email" Title="Email" Width="300px" Filterable="false" >
            <Template Context="data">
                <span>@data.Member.Entity.Email</span>
            </Template>
        </DataGridColumn>
        <DataGridColumn TItem="ViewModels.AssociatedMemberToEntryRow" Property="Amount" Title="Montant" Width="220px" Filterable="false" >
            <EditTemplate Context="data">
                <SuperInputCurrency @bind-Value="data.Amount" />
            </EditTemplate>
            <Template Context="data">
                <PriceLabel Value="@data.Amount" />
            </Template>
            <FooterTemplate>
                <PriceLabel Value="@total" />
            </FooterTemplate>
        </DataGridColumn>
        </ChildContent>
</SuperDataGrid>

