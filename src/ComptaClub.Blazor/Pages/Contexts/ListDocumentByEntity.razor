@using ComptaClub.Blazor.Services
@using ComptaClub.Blazor.ViewModels

@attribute [EntityContextAttribute(MetaEntity = MetaEntity.Entry,
	Title = "Documents",
	Icon = "fa-file-lines")]

@inherits DocumentListByEntity

@code {
	[Parameter]
    public ContextInfo ContextInfo { get; set; } = default!;

	protected override async Task OnParametersSetAsync()
    {
		MetaEntity = ContextInfo.MetaEntity;
        EntityId = ContextInfo.SelectedEntity.Id;
        if (grid is not null)
        {
            await ReloadItems();
        }
    }
}

<SectionContent SectionName="toolbar-context">
	<SuperButton Text="Associer"
					Click="InsertRow"
					Icon="fa-file-arrow-up"
					Style="SuperButtonStyle.Success"
					class="btn btn-primary m-1"
					title="Associer un document à cette écriture" />
</SectionContent>

<SuperDataGrid RowHeight="55" @ref="grid" DisplaySelectionColumn="false" DisplayColumnVisibilityToggle="false"
				AllowFiltering="true"
				AllowSorting="true"
				AllowColumnResize="true"
				ItemsProvider="LoadItems"

				TItem="ViewModels.Document"

				DisplayRowNumberColumn="true"
				Height="500px" ActionsWidth="120">
		<ActionsTemplate Context="doc">
			@if (grid.IsRowInEditMode(doc))
			{
				<SuperButton Icon="fa-check" Style="SuperButtonStyle.Success"  Size="SuperButtonSize.Default" Click="@((args) => SaveRow(doc))">
				</SuperButton>
				<SuperButton Icon="fa-xmark" Style="SuperButtonStyle.Light"  Size="SuperButtonSize.Default" Class="my-1 ms-1" Click="@((args) => CancelEdit(doc))">
				</SuperButton>
			}
			else
			{
				<SuperButton Icon="fa-trash" Style="SuperButtonStyle.Warning"  Size="SuperButtonSize.Default" Click="@(args => DeleteRow(doc))" @onclick:stopPropagation="true" title="Supprimer ce fichier">
				</SuperButton>
				<SuperButton Icon="fa-pen" Style="SuperButtonStyle.Light"  Size="SuperButtonSize.Default" Click="@(args => EditRow(doc))" @onclick:stopPropagation="true" title="Editer ce fichier">
				</SuperButton>
			}
		</ActionsTemplate>
		<ChildContent>
		<DataGridColumn TItem="ViewModels.Document" Property="FileName" Title="Fichier" Width="350px" Filterable="false">
			<Template Context="data">
				<a href="/document/@data.Id">@data.FileName</a>
			</Template>
			<EditTemplate Context="data">
				<input class="form-control w-100" @bind="data.FileName" />
				<BrokenRuleMessage For="() => data.FileName" BrokenRuleList="brokenRules" />
			</EditTemplate>
		</DataGridColumn>
		<DataGridColumn TItem="ViewModels.Document" Property="Description" Title="Description" Filterable="false" >
			<EditTemplate Context="data">
				<input class="form-control w-100" @bind="data.Description" />
				<BrokenRuleMessage For="() => data.Description" BrokenRuleList="brokenRules" />
			</EditTemplate>
		</DataGridColumn>
		<DataGridColumn TItem="ViewModels.Document" Property="LastUpdate" Title="Màj." Width="150px" Filterable="false" >
			<Template Context="data">
				<DateLabel Value="data.LastUpdate" />
			</Template>
		</DataGridColumn>
		<DataGridColumn TItem="ViewModels.Document" Property="Size" Title="Taille" Width="120px" TextAlign="SuperTextAlignment.Right" Filterable="false" >
			<Template Context="doc">
				<FileSizeLabel FileSize="@doc.Size"/>
			</Template>
		</DataGridColumn>
		</ChildContent>
</SuperDataGrid>


