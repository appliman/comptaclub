@inherits LayoutComponentBase
@using SuperBlazorComponents.Components
@using SuperBlazorComponents.Components.SuperLayout

<SuperDialog />
<SuperNotification />
<SuperConfirmDialog />


<PageTitle>ComptaClub</PageTitle>

<SuperLayout>
    <SuperHeader BrandText="Compta Club" ShowToggle="@(user?.IsAuthenticated == true)">
        <ChildContent>
            <SectionOutlet SectionName="toolbar" />
            <SectionOutlet SectionName="toolbar-context" />
        </ChildContent>
        <EndContent>
            @if (loaderVisible)
            {
                <div class="spinner-border mx-2" role="status">
                    <span class="visually-hidden">Chargement...</span>
                </div>
            }
            <UserInfo />
            <ConnectionButton />
        </EndContent>
    </SuperHeader>
    @if (user?.IsAuthenticated == true)
    {
        <SuperSidebar>
            <ChildContent>
            <SuperMenuItem Href="/" Text="Accueil" Icon="fa-chart-column" Match="NavLinkMatch.All" />
            <SuperMenuItem Href="/ecritures" Text="Ecritures" Icon="fa-receipt" />
            <SuperMenuItem Href="/comptes-resultats" Text="Comptes de résultats" Icon="fa-award" />
            <SuperMenuItem Href="/bilans-previsionnels" Text="Bilans prévisionnels" Icon="fa-chart-line" />
            <SuperMenuItem Href="/membres" Text="Membres" Icon="fa-users" />
            <SuperMenuItem Href="/documents" Text="Documents" Icon="fa-file-lines" />
            <SuperMenuItem Text="Configuration" Icon="fa-gear">
                <Items>
                    <SuperMenuItem Href="/utilisateurs" Text="Utilisateurs" Icon="fa-users" />
                    <SuperMenuItem Href="/plan" Text="Plan comptable" Icon="fa-list" />
                    <SuperMenuItem Href="/exercices" Text="Exercices" Icon="fa-calendar-days" />
                    <SuperMenuItem Href="/banques" Text="Banques" Icon="fa-landmark" />
                    <SuperMenuItem Href="/club" Text="Club" Icon="fa-heart" />
                </Items>
            </SuperMenuItem>
            </ChildContent>
            <Footer><small>Version : @version</small></Footer>
        </SuperSidebar>
    }
    <SuperBody>
        <AuthorizeView>
            <Authorized>
                <CascadingValue Value="this">@Body</CascadingValue>
            </Authorized>
            <NotAuthorized>
                <LoginPartial />
            </NotAuthorized>
        </AuthorizeView>
    </SuperBody>
</SuperLayout>
