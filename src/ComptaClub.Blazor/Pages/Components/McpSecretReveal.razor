@implements IAsyncDisposable
@inject IJSRuntime JS

@code {
    [Parameter, EditorRequired] public string Secret { get; set; } = string.Empty;
    [Parameter] public EventCallback Dismissed { get; set; }
    private IJSObjectReference? _module;
    private string? _message;

    private async Task Copy()
    {
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Pages/Components/McpSecretReveal.razor.js");
            await _module.InvokeVoidAsync("copySecret", Secret);
            _message = "Clé copiée.";
        }
        catch (JSException)
        {
            _message = "La copie automatique est indisponible. Sélectionnez et copiez la clé.";
        }
    }

    public async ValueTask DisposeAsync()
    {
        Secret = string.Empty;
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}

<div class="alert alert-warning" role="alert">
    <h2 class="h5">Enregistrez cette clé maintenant</h2>
    <p>Elle donne accès à toutes les opérations de ComptaClub et ne sera plus affichée ensuite.</p>
    <code class="d-block text-break user-select-all mb-3">@Secret</code>
    <SuperButton Text="Copier la clé" Icon="fa-copy" Click="Copy" Style="SuperButtonStyle.Primary" />
    <SuperButton Text="J’ai enregistré la clé" Click="@(async () => await Dismissed.InvokeAsync())" Style="SuperButtonStyle.Secondary" />
    @if (_message is not null)
    {
        <p class="mt-2 mb-0" role="status">@_message</p>
    }
</div>
