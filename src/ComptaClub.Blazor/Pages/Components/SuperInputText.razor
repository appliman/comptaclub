<div class="form-group">
	<label class="control-label">@Label</label>
	@if (string.IsNullOrWhiteSpace(Prepend))
	{
		<div>
			<InputText type="@Type" class="form-control" Value="@Value" placeholder="@PlaceHoder" required="@(Required ? "required" : null)" ValueChanged="@ValueChanged" ValueExpression="@ValueExpression" />
		</div>
	}
	else
	{
		<div class="input-group">
			<span class="input-group-text"><i class="@Prepend"></i></span>
			<InputText type="@Type" class="form-control" Value="@Value" placeholder="@PlaceHoder" required="@(Required ? "required" : null)" ValueChanged="@ValueChanged" ValueExpression="@ValueExpression" />
		</div>
	}
	<small>
		<ValidationMessage For="@ValueExpression" />
	</small>
	@ChildContent
</div>

@code {

	[Parameter]
	public string? Label { get; set; } 

	[Parameter]
	public string Value { get; set; } = null!;

	[Parameter]
	public EventCallback<string> ValueChanged { get; set; }

	[Parameter]
	public System.Linq.Expressions.Expression<Func<string>> ValueExpression { get; set; } = null!;

	[Parameter]
	public string? PlaceHoder { get; set; }

	[Parameter]
	public bool Required { get; set; }

	[Parameter]
	public string Type { get; set; } = "text";
	
	[Parameter]
	public string? Prepend { get; set; }

	[Parameter]
	public RenderFragment? ChildContent { get; set; }

}
