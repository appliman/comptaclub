@if (!string.IsNullOrWhiteSpace(Label))
{
	<div class="mb-3">
		<label for="Name" class="form-label">@Label</label>
		<div class="input-group w-50">
			<span class="input-group-text"><span class="material-icons">€</span></span>
			<input type="text" step="0" class="form-control" value="@innerValue" @onchange="InnerValueChanged" placeholder="@PlaceHoder" required="@(Required ? "required" : null)" />
		</div>
		<small>
			<ValidationMessage class="invalid-feedback" For="() => Value" />
		</small>
		@ChildContent
	</div>
}
else
{
	<div class="input-group">
		<span class="input-group-text"><span class="material-icons">€</span></span>
		<input type="text" step="0" class="form-control w-25" value="@innerValue" @onchange="InnerValueChanged" placeholder="@PlaceHoder" required="@(Required ? "required" : null)" />
	</div>
	<small>
		<ValidationMessage class="invalid-feedback" For="() => Value" />
	</small>
}

@code {

	[Parameter]
	public string? Label { get; set; }

	[Parameter]
	public long Value { get; set; }

	[Parameter]
	public EventCallback<long> ValueChanged { get; set; }

	[Parameter]
	public System.Linq.Expressions.Expression<Func<long>>? ValueExpression { get; set; }

	[Parameter]
	public string? PlaceHoder { get; set; }

	[Parameter]
	public bool Required { get; set; }

	[Parameter]
	public RenderFragment? ChildContent { get; set; }

	System.Globalization.CultureInfo ci = default!;
	string innerValue = null!;

	protected override void OnInitialized()
	{
		ci = new System.Globalization.CultureInfo("fr-FR");
		ci.NumberFormat.CurrencyDecimalSeparator = ".";
		ci.NumberFormat.NumberDecimalSeparator = ".";

		innerValue = $"{Value / 1000000m}".Replace(",", ".");
	}

	void InnerValueChanged(ChangeEventArgs args)
	{
		if (args.Value is null)
		{
			innerValue = "0.00";
		}
		else
		{
			innerValue = $"{args.Value}".Replace(",", ".");
		}
		if (decimal.TryParse(innerValue, ci, out var decimalValue))
		{
			Value = (long)(decimalValue * 1000000m);
			if (ValueChanged.HasDelegate)
			{
				ValueChanged.InvokeAsync(Value);
			}
		}
	}


}
