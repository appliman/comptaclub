@if (!string.IsNullOrWhiteSpace(Label))
{
	<div class="mb-3 @otherClass" @attributes="CatpuredAttributes">
		<label for="Name" class="form-label">@Label</label>
		<div class="input-group">
			<span class="input-group-text"><span class="material-icons">€</span></span>
			<input type="text" 
				step="0" 
				class="form-control text-end" 
				value="@innerValue" 
				@onchange="InnerValueChanged"
				@onblur="BlurHandler"
				placeholder="@PlaceHoder" 
				required="@(Required ? "required" : null)" />
		</div>
		@if (WithValidation)
		{
			<small>
				<ValidationMessage class="invalid-feedback" For="() => Value" />
			</small>
		}
		@ChildContent
	</div>
}
else
{
	<div class="input-group">
		<span class="input-group-text"><span class="material-icons">€</span></span>
		<input type="text" 
			step="0" 
			class="form-control text-end @otherClass" 
			@attributes="CatpuredAttributes" 
			value="@innerValue" 
			@onchange="InnerValueChanged"
			@onblur="BlurHandler"
			placeholder="@PlaceHoder" 
			required="@(Required ? "required" : null)" />
	</div>
	@if (WithValidation)
	{
		<small>
			<ValidationMessage class="invalid-feedback" For="() => Value" />
		</small>
	}
	@ChildContent
}

@code {

	[Parameter]
	public string? Label { get; set; }

	[Parameter]
	public long Value { get; set; }

	[Parameter]
	public EventCallback<long> ValueChanged { get; set; }

	[Parameter]
	public EventCallback LostFocus { get; set; }

	[Parameter]
	public System.Linq.Expressions.Expression<Func<long>>? ValueExpression { get; set; }

	[Parameter]
	public string? PlaceHoder { get; set; }

	[Parameter]
	public bool Required { get; set; }

	[Parameter]
	public RenderFragment? ChildContent { get; set; }

	[Parameter]
	public bool WithValidation { get; set; } = true;

	[Parameter(CaptureUnmatchedValues = true)]
	public Dictionary<string, object> CatpuredAttributes { get; set; } = new();

	System.Globalization.CultureInfo ci = default!;
	string innerValue = null!;
	string? otherClass = null;

	protected override void OnInitialized()
	{
		ci = new System.Globalization.CultureInfo("fr-FR");
		ci.NumberFormat.CurrencyDecimalSeparator = ".";
		ci.NumberFormat.NumberDecimalSeparator = ".";

		innerValue = $"{Value / 1000000m:F2}".Replace(",", ".");
		otherClass = $"{CatpuredAttributes.GetValueOrDefault("class")}";
	}

	void InnerValueChanged(ChangeEventArgs args)
	{
		if (args.Value is null)
		{
			innerValue = "0.00";
		}
		else
		{
			innerValue = $"{args.Value}".Replace(",", ".");
		}
		if (decimal.TryParse(innerValue, ci, out var decimalValue))
		{
			Value = (long)(decimalValue * 1000000m);
			if (ValueChanged.HasDelegate)
			{
				ValueChanged.InvokeAsync(Value);
			}
		}
	}

	void BlurHandler(FocusEventArgs args)
	{
		if (LostFocus.HasDelegate)
		{
			LostFocus.InvokeAsync();
		}
	}


}
