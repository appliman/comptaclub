@foreach (var item in toolbarItems)
{
    @if (item is ViewModels.Toolbar.ToolbarButton)
    {
        var tbb = (ViewModels.Toolbar.ToolbarButton)item;
        <ToolbarButton ToolbarItem="tbb" />
    }
    else if (item is ViewModels.Toolbar.ToolbarLink)
    {
        var tbl = (ViewModels.Toolbar.ToolbarLink)item;
        <ToolbarLink ToolbarItem="tbl"/>
    }
}