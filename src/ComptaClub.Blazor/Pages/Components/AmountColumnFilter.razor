<button class="btn btn-light btn-sm w-100" role="button" @onclick="ShowDialog">
    <i class="fa fa-search" aria-hidden="true"></i>
    @ButtonLabel
</button>

@inject SuperBlazorComponents.Services.SuperDialogService DialogService

@code {
    [Parameter]
    public string Title { get; set; } = default!;

    [Parameter]
    public AmountFilter AmountFilter { get; set; } = default!;

    [Parameter]
    public EventCallback<AmountFilter> AmountFilterChanged { get; set; }

    [Parameter]
    public System.Linq.Expressions.Expression<Func<AmountFilter>> AmountFilterExpression { get; set; } = null!;


    [Parameter]
    public EventCallback ApplyFilter { get; set; }

    private string ButtonLabel => AmountFilter.Amount == 0
        ? "Montant"
        : $"{AmountFilter.Amount / 1000000m} €";

    private async Task ShowDialog()
    {
        var selectedFilter = await DialogService.OpenAsync<AmountColumnFilterDialog>(
            $"Filtrer la colonne {Title}",
            new Dictionary<string, object>
            {
                [nameof(AmountColumnFilterDialog.AmountFilter)] = new AmountFilter
                {
                    Amount = AmountFilter.Amount,
                    PrecisionInCentime = AmountFilter.PrecisionInCentime
                }
            },
            new DialogOptions { Width = "500px" });

        if (selectedFilter is not AmountFilter amountFilter)
        {
            return;
        }

        await AmountFilterChanged.InvokeAsync(amountFilter);
        await ApplyFilter.InvokeAsync();
    }
}
