@using ComptaClub.Datas;

@foreach (var item in ItemList.Where(i => i.Direction == AccountDirection))
{
	<tr>
		@for (int i = 0; i < Level; i++)
		{
			<td class="cell-indent"></td>
		}
		<td colspan="@(LevelMax - Level + 1)">
			<b>@item.AccountCode</b> @item.AccountLabel
		</td>
		@if (DisplayIncomeStatementAmount)
		{
			<td>
				<PriceLabel Value="@item.IncomeStatementAmount" />
			</td>
		}
		<td>
			@if (DisplayIncomeStatementAmount)
			{
				if (!item.Children.Any())
				{
					<SuperInputCurrency @bind-Value="item.Amount" WithValidation="false" style="width:80px; text-align:right;" LostFocus="LostFocus" />
				}
				else
				{
					<PriceLabel Value="@item.Amount" />
				}
			}
			else
			{
				<PriceLabel Value="@item.Amount" />
			}
		</td>
	</tr>
	<_ForcastBudgetItemList AccountDirection="AccountDirection" 
		ItemList="item.Children" 
		Level="@(Level + 1)" 
		Recompute="Recompute" 
		LevelMax="LevelMax"
		DisplayIncomeStatementAmount="DisplayIncomeStatementAmount"/>
}

@code {
	[Parameter]
	public List<ForecastBudgetItemData> ItemList { get; set; } = new();

	[Parameter]
	public AccountDirection AccountDirection { get; set; }

	[Parameter]
	public int Level { get; set; } = 1;

	[Parameter]
	public EventCallback Recompute { get; set; }

	[Parameter]
	public int LevelMax { get; set; }

	[Parameter]
	public bool DisplayIncomeStatementAmount { get; set; } = true;

	void LostFocus()
	{
		if (Recompute.HasDelegate)
		{
			Recompute.InvokeAsync();
		}
	}
}
