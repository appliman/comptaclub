@page "/plan"

<PageTitle>Plan</PageTitle>

@if (uploadEnabled)
{
	<div class="m-4">
		<label class="form-label">Veuillez indiquer le fichier à envoyer :</label>
		<InputFile OnChange="ImportFromJson" class="form-control" />
		@if (!string.IsNullOrWhiteSpace(uploadError))
		{
			<div class="danger">@uploadError</div>
		}
	</div>
}

<SectionContent SectionName="toolbar">

	<SuperButton Text="Compte"
				  Click="InsertRow"
				  Icon="fa-circle-plus"
				  Style="SuperButtonStyle.Success"
				  Disabled="@(!isPlanLoaded || accountToInsert != null || accountToUpdate != null)"
				  class="btn btn-primary m-1"
				  title="Ajouter un compte" />

	<SuperButton Text="Exporter"
				  Click="ExportToJson"
				  Icon="fa-file-arrow-down"
				  Style="SuperButtonStyle.Success"
				  Disabled="@(!isPlanLoaded)"
				  class="btn btn-primary m-1"
				  title="Exporter" />

	<SuperButton Text="Importer"
				  Click="Import"
				  Icon="fa-file-arrow-up"
				  Style="SuperButtonStyle.Success"
				  Disabled="@(!isPlanLoaded)"
				  class="btn btn-primary m-1"
				  title="Importer" />

	<SuperButton Text="Déployer"
				  Click="DeployAll"
				  Icon="fa-expand"
				  Style="SuperButtonStyle.Success"
				  Disabled="@(!isPlanLoaded)"
				  class="btn btn-primary m-1"
				  title="Voir tous les comptes" />

</SectionContent>

@if (!string.IsNullOrWhiteSpace(uploadSuccess))
{
	<div class="success m-4">@uploadError</div>
}
@if (!isPlanLoaded)
{
	<p class="m-4">Chargement du plan comptable…</p>
}
else
{
<div style="height:100%">
	<SuperDataGrid RowHeight="55" @ref="grid" DisplaySelectionColumn="false" DisplayColumnVisibilityToggle="false"
					AllowFiltering="false"
					AllowSorting="false"
					AllowColumnResize="true"
					Hierarchical="true" HierarchyKeySelector="@(account => account.Id)" ActionsWidth="170"
					ItemsProvider="LoadItems"
					TItem="ViewModels.Account"


					DisplayRowNumberColumn="true"
					Height="500px">
			<ActionsTemplate Context="account">
				@if (grid!.IsRowInEditMode(account))
				{
					<SuperButton Icon="fa-check" Style="SuperButtonStyle.Success"  Size="SuperButtonSize.Default" Click="@((args) => SaveRow(account))">
					</SuperButton>
					<SuperButton Icon="fa-xmark" Style="SuperButtonStyle.Light"  Size="SuperButtonSize.Default" Class="my-1 ms-1" Click="@((args) => CancelEdit(account))">
					</SuperButton>
				}
				else
				{
					<SuperButton Icon="fa-trash" Style="SuperButtonStyle.Warning"  Size="SuperButtonSize.Default" Click="@(args => DeleteRow(account))" @onclick:stopPropagation="true" title="Supprimer ce compte">
					</SuperButton>
					<SuperButton Icon="fa-circle-plus" Style="SuperButtonStyle.Light"  Size="SuperButtonSize.Default" Click="@(args => InsertRow(account))" @onclick:stopPropagation="true" title="Ajouter un sous-compte">
					</SuperButton>
					<SuperButton Icon="fa-pen" Style="SuperButtonStyle.Light"  Size="SuperButtonSize.Default" Click="@(args => EditRow(account))" @onclick:stopPropagation="true" title="Editer ce compte">
					</SuperButton>
				}
			</ActionsTemplate>
			<ChildContent>
			<DataGridColumn TItem="ViewModels.Account" Property="Direction" Title="Débit / Crédit" Width="150px">
				<EditTemplate Context="account">
					@if (!account.ParentAccountId.HasValue)
					{
						<select class="form-select" @bind="account.Direction">
                            @foreach (var direction in Enum.GetValues<Enums.AccountDirection>())
                            {
                                <option value="@direction">@direction</option>
                            }
                        </select>
					}
				</EditTemplate>
			</DataGridColumn>
			<DataGridColumn TItem="ViewModels.Account" Property="Code" Title="Code Compta" Width="120px" Filterable="false">
				<EditTemplate Context="account">
					<input class="form-control w-100" @bind="account.Code" />
					<BrokenRuleMessage For="() => account.Code" BrokenRuleList="brokenRules" />
				</EditTemplate>
			</DataGridColumn>
			<DataGridColumn TItem="ViewModels.Account" Property="Label" Title="Libellé du code compta" Filterable="false">
				<EditTemplate Context="account">
					<input class="form-control w-100" @bind="account.Label" />
					<BrokenRuleMessage For="() => account.Label" BrokenRuleList="brokenRules" />
				</EditTemplate>
			</DataGridColumn>
			</ChildContent>
	</SuperDataGrid>
</div>
}
