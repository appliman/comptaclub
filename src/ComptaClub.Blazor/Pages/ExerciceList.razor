@page "/exercices"

<PageTitle>Exercices</PageTitle>

<RadzenDataGrid @ref="grid" 
    AllowFiltering="true" 
    AllowSorting="true" 
    AllowColumnResize="true"
    Data="@exerciceList"
    LoadData="@LoadDatas"
    TItem="ViewModels.Exercice"
    ColumnWidth="80px">
    <Columns>
        <RadzenDataGridColumn TItem="ViewModels.Exercice" Property="Code" Title="Code Exercice" Width="120px" Filterable="false">
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ViewModels.Exercice" Property="Label" Title="Libellé" Width="120px" Filterable="false">
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ViewModels.Exercice" Property="InitialAmount" Title="Solde de départ" Width="120px" Filterable="false">
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ViewModels.Exercice" Property="BalanceAmount" Title="Solde courant" Width="120px" Filterable="false">
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ViewModels.Exercice" Property="StartDate" Title="Date de départ" Width="120px" Filterable="false" FormatString="{0:dd/MM/yy}">
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ViewModels.Exercice" Property="EndDate" Title="Date de fin" Width="120px" Filterable="false" FormatString="{0:dd/MM/yy}">
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ViewModels.Exercice" Title="Actif" Width="90px" Filterable="false">
            <Template Context="exercice">
                @if (exercice.Active)
                {
                    <input type="radio" checked @onchange="@((args) => ChangeActiveExercice(args, exercice))" />
                }
                else
                {
                    <input type="radio" @onchange="@((args) => ChangeActiveExercice(args, exercice))" />
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ViewModels.Exercice" Context="exercice" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Width="156px">
            <Template Context="exercice">
                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@(args => EditRow(exercice))" @onclick:stopPropagation="true" title="Editer cet exercice">
                </RadzenButton>
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Warning" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@(args => DeleteRow(exercice))" @onclick:stopPropagation="true" title="Supprimer cet exercice">
                </RadzenButton>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>