@page "/exercices"

<PageTitle>Exercices</PageTitle>

<SectionContent SectionName="toolbar">

    <SuperLinkButton Text="Ajouter"
                Href="/exercice/ajout"
                Icon="fa-circle-plus"
                Target="_blank"
                Style="SuperButtonStyle.Success"
                class="btn btn-primary m-1"
                title="Ajouter un exercice" />

    <SuperButton Text="Clore"
                  Click="CloseExercice"
                  Icon="fa-compress"
                  Style="SuperButtonStyle.Success"
                  class="btn btn-primary m-1"
                  title="Clore l'exercice" />

</SectionContent>

<div style="height:100%">
<SuperDataGrid RowHeight="55" @ref="grid" DisplaySelectionColumn="false" DisplayColumnVisibilityToggle="false"
    AllowFiltering="false"
    AllowSorting="true"
    AllowColumnResize="true"
    ItemsProvider="LoadItems"

    TItem="ViewModels.Exercice"
    SelectionMode="SuperDataGridSelectionMode.Single" DisplayRowNumberColumn="false"

    SelectionChanged="OnSelectionChanged"
    Height="500px" ActionsWidth="120">
        <ActionsTemplate Context="exercice">
            @if (exercice.ExerciceState != ExerciceState.Closed)
            {
                    <SuperButton Icon="fa-trash" Style="SuperButtonStyle.Warning"  Size="SuperButtonSize.Default" Click="@(args => DeleteRow(exercice))" @onclick:stopPropagation="true" title="Supprimer cet exercice">
                    </SuperButton>
                    <SuperButton Icon="fa-pen" Style="SuperButtonStyle.Light"  Size="SuperButtonSize.Default" Click="@(args => EditRow(exercice))" @onclick:stopPropagation="true" title="Editer cet exercice">
                </SuperButton>
            }
        </ActionsTemplate>
        <ChildContent>
        <DataGridColumn TItem="ViewModels.Exercice" Property="Code" Title="Code Exercice" Width="200px" Filterable="false">
        </DataGridColumn>
            <DataGridColumn TItem="ViewModels.Exercice" Title="Actif" Width="90px" Filterable="false">
                <Template Context="exercice">
                    @if (exercice.Active)
                    {
                        <input type="radio" checked @onchange="@((args) => ChangeActiveExercice(args, exercice))" />
                    }
                    else
                    {
                        <input type="radio" @onchange="@((args) => ChangeActiveExercice(args, exercice))" />
                    }
                </Template>
            </DataGridColumn>
            <DataGridColumn TItem="ViewModels.Exercice" Property="Label" Title="Libellé" Filterable="false">
        </DataGridColumn>
        <DataGridColumn TItem="ViewModels.Exercice" Property="InitialAmount" Title="Solde de départ" Width="150px" Filterable="false">
            <Template Context="data">
                <PriceLabel Value="data.InitialAmount" />
            </Template>
        </DataGridColumn>
        <DataGridColumn TItem="ViewModels.Exercice" Property="BalanceAmount" Title="Solde courant" Width="150px" Filterable="false">
            <Template Context="data">
                <PriceLabel Value="data.BalanceAmount"/>
            </Template>
        </DataGridColumn>
        <DataGridColumn TItem="ViewModels.Exercice" Property="StartDate" Title="Date de départ" Width="150px" Filterable="false" FormatString="{0:dd/MM/yy}">
            <Template Context="data">
                <DateLabel Value="data.StartDate" />
            </Template>
        </DataGridColumn>
        <DataGridColumn TItem="ViewModels.Exercice" Property="EndDate" Title="Date de fin" Width="150px" Filterable="false" FormatString="{0:dd/MM/yy}">
            <Template Context="data">
                <DateLabel Value="data.EndDate" />
            </Template>
        </DataGridColumn>
        <DataGridColumn TItem="ViewModels.Exercice" Property="ExerciceState" Title="Etat" Width="100px" Filterable="false">
            <Template Context="exercice">
                <SuperEnumLabel Value="@exercice.ExerciceState"/>
            </Template>
        </DataGridColumn>
        </ChildContent>
</SuperDataGrid>
</div>
