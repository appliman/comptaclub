@page "/"
<PageTitle>Accueil</PageTitle>

<h3 class="mt-3">@currentExercice.Label en cours du @string.Format(ci,"{0:dddd dd MMMM yyyy}", currentExercice.StartDate) au @string.Format(ci,"{0:dddd dd MMMM yyyy}", currentExercice.EndDate)</h3>

<div class="row mt-3">
    <div class="col-6">
        <RadzenCard class="rz-card-index mb-2" Style="height:120px;">
            <div class="row align-items-center">
                <div class="col-sm-8 col-col-lg-12 col-xl">
                    <h3 class="m-0">Solde</h3>
                </div>
                <div class="col-sm-4 text-sm-right col-lg-12 text-lg-left col-xl-auto text-xl-right">
                    <label class="green-color text-48">
                        @currentExercice.BalanceAmount.ToString("#,##0.00€")
                    </label>
                </div>
            </div>
        </RadzenCard>
    </div>
    <div class="col-6">
        <RadzenCard class="rz-card-index mb-2" Style="height:120px;">
            <div class="row align-items-center">
                <div class="col-sm-8 col-col-lg-12 col-xl">
                    <h3 class="m-0">Nombre de membres</h3>
                </div>
                <div class="col-sm-4 text-sm-right col-lg-12 text-lg-left col-xl-auto text-xl-right">
                    <label class="green-color text-48">@memberCount</label>
                </div>
            </div>
        </RadzenCard>
    </div>
</div>
<RadzenChart>
    <RadzenLineSeries Smooth="false" 
        Stroke="blue" 
        StrokeWidth="3" 
        Data="@balanceByDayList" 
        CategoryProperty="Day" 
        Title="Solde" 
        LineType="LineType.Solid" 
        ValueProperty="BalanceAmount">
        <TooltipTemplate Context="data">
            <div>
                Solde @string.Format("{0:#,##0.00}€", data.BalanceAmount) le @string.Format("{0:dddd dd MMMM yyyy}", data.Day)
            </div>
        </TooltipTemplate>
    </RadzenLineSeries>
    <RadzenCategoryAxis FormatString="{0:dd.MM.yy}">
        <RadzenGridLines Visible="true" />
        <RadzenAxisTitle Text="Jour" />
    </RadzenCategoryAxis>
    <RadzenValueAxis FormatString="{0:#,##0.00}€">
        <RadzenGridLines Visible="true" LineType="LineType.Dotted" />
        <RadzenAxisTitle Text="Solde" />
    </RadzenValueAxis>
</RadzenChart>

<div class="row mt-4">
    <div class="col-6">
        <AccountingPlanTotal Plan="plan" Direction="Datas.AccountDirection.Debit" Title="Charges"/>
    </div>
    <div class="col-6">
        <AccountingPlanTotal Plan="plan" Direction="Datas.AccountDirection.Credit" Title="Produits"/>
    </div>
</div>