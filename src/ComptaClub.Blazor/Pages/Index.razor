@page "/"
<PageTitle>Accueil</PageTitle>

<h3 class="mt-3">@currentExercice.Label en cours du @string.Format(ci,"{0:dddd dd MMMM yyyy}", currentExercice.StartDate) au @string.Format(ci,"{0:dddd dd MMMM yyyy}", currentExercice.EndDate)</h3>

<div class="row mt-3">
    <div class="col-6">
        <div class="card mb-2 p-3" style="height:120px;">
            <div class="row align-items-center">
                <div class="col-sm-8 col-col-lg-12 col-xl">
                    <h3 class="m-0">Solde</h3>
                </div>
                <div class="col-sm-4 text-sm-right col-lg-12 text-lg-left col-xl-auto text-xl-right">
                    <label class="green-color text-48">
                        <PriceLabel class=""  Value="@currentExercice.BalanceAmount" />
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6">
        <div class="card mb-2 p-3" style="height:120px;">
            <div class="row align-items-center">
                <div class="col-sm-8 col-col-lg-12 col-xl">
                    <h3 class="m-0">Nombre de membres</h3>
                </div>
                <div class="col-sm-4 text-sm-right col-lg-12 text-lg-left col-xl-auto text-xl-right">
                    <label class="green-color text-48">@memberCount</label>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row g-3 align-items-start mt-2">
    <div class="col-12 col-lg-8">
        @if (balanceByDayList.Any())
        {
            <div class="home-balance-chart">
                <BalanceChart Data="balanceByDayList" />
            </div>
        }
    </div>
    <div class="col-12 col-lg-4">
        <div class="home-breakdown-chart">
            <ChargesProduitsPieChart Charges="_chargesAmount" Produits="_produitsAmount" />
        </div>
    </div>
</div>
@if (_previousExercice is not null)
{
    <p class="mt-4 mb-0">Comparaison : exercice N (@currentExercice.Label) et exercice N-1 (@_previousExercice.Label).</p>
}
<div class="row mt-4">
    <div class="col-12 col-xl-6">
        <AccountingPlanTotal Plan="plan" PreviousExerciceId="@_previousExercice?.Id" Direction="Enums.AccountDirection.Debit" Title="Charges" />
    </div>
    <div class="col-12 col-xl-6">
        <AccountingPlanTotal Plan="plan" PreviousExerciceId="@_previousExercice?.Id" Direction="Enums.AccountDirection.Credit" Title="Produits" />
    </div>
</div>
