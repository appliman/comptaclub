@using ComptaClub.Blazor.Services
@using ComptaClub.Blazor.ViewModels

@inject EntityContextService EntityContextService

@inject NavigationManager NavigationManager

@code {

    List<ContextInfo> contextInfoList = new();
    List<ContextInfo> OrderedContexts => contextInfoList.OrderByDescending(i => i.DefaultPosition).ToList();
    int selectedTab = 0;

    protected override void OnInitialized()
    {
        EntityContextService.ChangeTabByName += (s, arg) =>
        {
            ChangeTabByName(arg);
        };
    }

    public void ContextChanged<T>(object parent, T entity, ContextLocation contextLocation) 
    where T : IMetaEntity
    {
        var pathAndQuery = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);

        contextInfoList.RemoveAll(i => i.MetaEntity == entity.MetaEntity);
        var list = EntityContextService.GetContextInfoList(entity.MetaEntity, contextLocation);
        foreach (var ctx in list)
        {
            var routes = $"{ctx.ExcludeRoutes}".Split(',').ToList();
            routes.RemoveAll(i => string.IsNullOrWhiteSpace(i));
            if (routes.Any(i => pathAndQuery.StartsWith(i, StringComparison.InvariantCultureIgnoreCase)))
            {
                continue;
            }

            ctx.Parent = parent;
            ctx.SelectedEntity = entity;
            contextInfoList.Add(ctx);
        }
        StateHasChanged();
    }

    public void ChangeTabByName(string name)
    {
        var tab = contextInfoList.FirstOrDefault(i => i.Title.IgnoreCaseEquals(name));
        if (tab is not null)
        {
            selectedTab = OrderedContexts.IndexOf(tab);
            base.StateHasChanged();
        }
    }

    void TabChanged(int selectedTab)
    {
        this.selectedTab = selectedTab;
        var ordered = OrderedContexts;
        if (selectedTab < 0 || selectedTab >= ordered.Count)
        {
            return;
        }
        var tab = ordered[selectedTab];
        EntityContextService.OnTabChanged(tab.Title);
    }
}

<SuperTabs Position="SuperTabPosition.Bottom" SelectedIndex="selectedTab" SelectedIndexChanged="TabChanged">
    <Tabs>
        @foreach (var item in OrderedContexts)
        {

            if (item.Parent is IContextRefreshable refreshable)
            {
                item.ReloadBodyPanel = EventCallback.Factory.Create<IMetaEntity>(refreshable, refreshable.RefreshFromContext);
            }

            var parameters = new Dictionary<string, object>()
            {
                { "ContextInfo", item }
              };
            <TabItem Title="@item.Title" Icon="@item.Icon" IconColor="@item.IconColor">
                <DynamicComponent Type="@item.ComponentType" Parameters="@parameters" />
            </TabItem>
        }
    </Tabs>
</SuperTabs>

