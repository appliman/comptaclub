@using ComptaClub.Blazor.ViewModels;


<RadzenDataGrid @ref="grid"
                AllowFiltering="false"
                AllowSorting="false"
                AllowColumnResize="true"
                Data="@associatedMemberList"
                LoadData="LoadDatas"
                TItem="ViewModels.AssociatedMemberToEntryRow"
                GridLines="DataGridGridLines.Both"
                FilterMode="FilterMode.Simple">
    <Columns>
        <RadzenDataGridColumn TItem="ViewModels.AssociatedMemberToEntryRow" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Width="100px">
            <Template Context="member">
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Warning" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@(args => DeleteRow(member))" @onclick:stopPropagation="true" title="Supprimer cette liaison">
                </RadzenButton>
                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@(args => EditRow(member))" @onclick:stopPropagation="true" title="Modifier cette liaison">
                </RadzenButton>
            </Template>
            <EditTemplate Context="member">
                <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@((args) => Save(member))">
                </RadzenButton>
                <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" Class="my-1 ms-1" Click="@((args) => CancelEdit(member))">
                </RadzenButton>
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ViewModels.AssociatedMemberToEntryRow" Property="Name" Title="Nom" Filterable="false" Frozen="false">
            <Template Context="data">
                <span>@data.Member.Entity.Name</span>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ViewModels.AssociatedMemberToEntryRow" Property="Email" Title="Email" Width="300px" Filterable="false" Frozen="false">
            <Template Context="data">
                <span>@data.Member.Entity.Email</span>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ViewModels.AssociatedMemberToEntryRow" Property="Amount" Title="Montant" Width="220px" Filterable="false" Frozen="false">
            <EditTemplate Context="data">
                <SuperInputCurrency @bind-Value="data.Amount" />
            </EditTemplate>
            <Template Context="data">
                <PriceLabel Value="@data.Amount" />
            </Template>
            <FooterTemplate>
                <PriceLabel Value="@total" />
            </FooterTemplate>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>
