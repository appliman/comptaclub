@page "/reports/bilan-previsionnel/{ForecastBudgetId:guid}"
@layout ReportLayout

<div id="header container">
	<div id="header-left">
		<div id="logo">
			<h3>@club.Name</h3>
			<img class="img-thumbnail" style="width:180px; height:180px;" width="180" height="180" src="data:@club.LogoContentType;base64,@club.LogoBase64String">
		</div>
		<table id="club-infos" cellpadding="0" cellspacing="0" border="0">
			<tbody>
				<tr>
					<td class="label">Adresse</td>
					<td>@club.Address</td>
				</tr>
				<tr>
					<td class="label">Web</td>
					<td>@club.WebSite</td>
				</tr>
				<tr>
					<td class="label">Email</td>
					<td>@club.Email</td>
				</tr>
				<tr>
					<td class="label">N° SIRET</td>
					<td>@club.SiretNumber</td>
				</tr>
				<tr>
					<td class="label">N° RNA</td>
					<td>@club.RNA</td>
				</tr>
			</tbody>
		</table>
	</div>
	<div id="header-right">
		<table id="doc-infos" class="bordertable" cellpadding="0" cellspacing="0" border="0">
			<thead>
				<tr>
					<th colspan="2">@forecastBudget.Name</th>
				</tr>
			</thead>
			<tbody>
				<tr class="first">
					<td class="label">Date :</td>
					<td>@forecastBudget.CreationDate.FromDayId().ToString("dd/MM/yyyy")</td>
				</tr>
				<tr class="last">
					<td class="label">Description :</td>
					<td>@forecastBudget.Description</td>
				</tr>
			</tbody>
		</table>
	</div>
</div>
<div id="content">
	<table class="table table-bordered">
		<tbody>
			@foreach (var direction in new List<AccountDirection>() { AccountDirection.Debit, AccountDirection.Credit })
			{
				<tr>
					<td colspan="@(levelMax + 1)">
						@if (direction == AccountDirection.Credit)
						{
							<span class="h2">Produit</span>
						}
						else
						{
							<span class="h2">Charge</span>
						}
					</td>
					<td class="cell-header" style="text-align:right;">
						@if (direction == AccountDirection.Credit)
						{
							<PriceLabel class="" Value="@forecastBudget.CreditTotal" />
						}
						else
						{
							<PriceLabel class="" Value="@forecastBudget.DebitTotal" />
						}
					</td>
				</tr>
				<_ForcastBudgetItemList AccountDirection="direction" 
					ItemList="forecastBudget.ItemList" 
					LevelMax="levelMax"
					DisplayIncomeStatementAmount ="false"/>
			}
			<tr>
				<td colspan="@(levelMax + 1)">
					<span class="h2">Résultat Net</span>
				</td>
				<td class="cell-header" style="text-align:end">
					@{
						var netIncome = forecastBudget.CreditTotal - forecastBudget.DebitTotal;
					}
					<PriceLabel class="" Value="@netIncome" />
				</td>
			</tr>
		</tbody>
	</table>
</div>
<div id="footer">
	<div id="footer-last">
		@forecastBudget.Name du @forecastBudget.CreationDate.FromDayId().ToString("dd/MM/yyyy")
	</div>
</div>
