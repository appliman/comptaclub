@page "/importation-ecritures"

<h3>Importation des écriture à partir d'un fichier ".ofx"</h3>

<InputFile OnChange="LoadFile" />

<SuperDataGrid @ref="grid"
    AllowFiltering="false"
    AllowSorting="true"
    AllowColumnResize="true"
    ItemsProvider="LoadItems"
    TItem="ViewModels.EntryRow"
    Height="500px"
    DisplaySelectionColumn="false"
    DisplayRowNumberColumn="false"
    SelectionMode="SuperDataGridSelectionMode.None"
    FreezeLeftColumns="1">
        <DataGridColumn TItem="ViewModels.EntryRow" Property="RowIndex" Title="#" Width="50px" Filterable="false">
        </DataGridColumn>
        <DataGridColumn TItem="ViewModels.EntryRow" Filterable="false" Sortable="false" TextAlign="SuperTextAlignment.Right" Width="70px">
            <Template Context="entry">
                <SuperButton Icon="fa-floppy-disk" Style="SuperButtonStyle.Success"  Size="SuperButtonSize.Default" Click="@(args => SaveRow(entry))" @onclick:stopPropagation="true" title="Editer cette ecriture">
                </SuperButton>
            </Template>
        </DataGridColumn>
        <DataGridColumn TItem="ViewModels.EntryRow" Property="CreationDate" Title="Date" Width="150px" Filterable="false">
            <Template Context="data">
                <DateIdLabel Value="data.Entity.CreationDate"/>
            </Template>
        </DataGridColumn>
        <DataGridColumn TItem="ViewModels.EntryRow" Title="Compte" Filterable="false" Sortable="false" Width="300px">
            <Template Context="entry">
                <AccountLinkSelector @bind-AccountId="entry.Entity.AccountId" AccountDirection="entry.Entity.AccountDirection" />
            </Template>
        </DataGridColumn>
        <DataGridColumn TItem="ViewModels.EntryRow" Property="PartNumber" Title="N°" Filterable="false">
            <Template Context="data">
                <div class="w-100">
                    @data.Entity.PartNumber<br />
                    @data.Entity.Label
                </div>
            </Template>
        </DataGridColumn>
        <DataGridColumn TItem="ViewModels.EntryRow" Title="Débit" Width="120px" Filterable="false" Sortable="false">
            <Template Context="entry">
                @if (entry.Entity.AccountDirection == Enums.AccountDirection.Debit)
                {
                    <PriceLabel Value="@entry.Entity.Amount" />
                }
            </Template>
        </DataGridColumn>
        <DataGridColumn TItem="ViewModels.EntryRow" Title="Crédit" Width="120px" Filterable="false" Sortable="false">
            <Template Context="entry">
                @if (entry.Entity.AccountDirection == Enums.AccountDirection.Credit)
                {
                    <PriceLabel Value="@entry.Entity.Amount" />
                }
            </Template>
        </DataGridColumn>
</SuperDataGrid>
