@page "/banques"

<PageTitle>Banques</PageTitle>

<SectionContent SectionName="toolbar">
	<SuperButton Text="Banque"
				  Click="InsertRow"
				  Icon="fa-circle-plus"
				  Style="SuperButtonStyle.Success"
				  class="btn btn-primary m-1"
				  title="Ajouter une banque" />

</SectionContent>

<div style="height:100%">
	<SuperDataGrid RowHeight="55" @ref="grid" DisplaySelectionColumn="false" DisplayColumnVisibilityToggle="false"
					AllowFiltering="true"
					AllowSorting="true"
					AllowColumnResize="true"
					ItemsProvider="LoadItems"

					TItem="ViewModels.BankRow"
					DisplayRowNumberColumn="false"
					Height="500px" ActionsWidth="120">
			<ActionsTemplate Context="bank">
				@if (grid.IsRowInEditMode(bank))
				{
					<SuperButton Icon="fa-check" Style="SuperButtonStyle.Success"  Size="SuperButtonSize.Default" Click="@((args) => SaveRow(bank))">
					</SuperButton>
					<SuperButton Icon="fa-xmark" Style="SuperButtonStyle.Light"  Size="SuperButtonSize.Default" Class="my-1 ms-1" Click="@((args) => CancelEdit(bank))">
					</SuperButton>
				}
				else
				{
					<SuperButton Icon="fa-trash" Style="SuperButtonStyle.Warning"  Size="SuperButtonSize.Default" Click="@(args => DeleteRow(bank))" @onclick:stopPropagation="true" title="Supprimer cette banque">
					</SuperButton>
					<SuperButton Icon="fa-pen" Style="SuperButtonStyle.Light"  Size="SuperButtonSize.Default" Click="@(args => EditRow(bank))" @onclick:stopPropagation="true" title="Editer cette banque">
					</SuperButton>
				}
			</ActionsTemplate>
			<ChildContent>
			<DataGridColumn TItem="ViewModels.BankRow" Property="Entity.Code" Title="Code Banque" Width="220px" Filterable="false">
				<Template Context="bank">@bank.Entity.Code</Template>
				<EditTemplate Context="bank">
					<input class="form-control w-100" @bind="bank.Entity.Code" />
					<BrokenRuleMessage For="() => bank.Entity.Code" BrokenRuleList="brokenRules" />
				</EditTemplate>
			</DataGridColumn>
			<DataGridColumn TItem="ViewModels.BankRow" Title="Actif" Width="90px" Filterable="false">
				<Template Context="bank">
					@if (bank.Entity.Active)
					{
						<input type="radio" checked @onchange="@((args) => ChangeActiveBank(args, bank))" />
					}
					else
					{
						<input type="radio" @onchange="@((args) => ChangeActiveBank(args, bank))" />
					}
				</Template>
			</DataGridColumn>
			<DataGridColumn TItem="ViewModels.BankRow" Property="Entity.Label" Title="Libellé" Filterable="false">
				<Template Context="bank">@bank.Entity.Label</Template>
				<EditTemplate Context="bank">
					<input class="form-control w-100" @bind="bank.Entity.Label" />
					<BrokenRuleMessage For="() => bank.Entity.Label" BrokenRuleList="brokenRules" />
				</EditTemplate>
			</DataGridColumn>
			</ChildContent>
	</SuperDataGrid>
</div>

