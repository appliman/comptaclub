@page "/banques"

<PageTitle>Banques</PageTitle>

<SectionContent SectionName="toolbar">
	<RadzenButton Text="Banque"
				  Click="InsertRow"
				  Icon="add_circle_outline"
				  ButtonStyle="ButtonStyle.Success"
				  class="btn btn-primary m-1"
				  title="Ajouter une banque" />

</SectionContent>

<div style="height:100%">
	<RadzenDataGrid @ref="grid"
					AllowFiltering="true"
					AllowSorting="true"
					AllowColumnResize="true"
					Data="@bankList"
					LoadData="LoadDatas"
					TItem="ViewModels.BankRow"
					EditMode="DataGridEditMode.Single"
					Style="height:100%">
		<Columns>
			<RadzenDataGridColumn TItem="ViewModels.BankRow" Context="bank" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Width="100px">
				<Template Context="bank">
					<RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Warning" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@(args => DeleteRow(bank))" @onclick:stopPropagation="true" title="Supprimer cette banque">
					</RadzenButton>
					<RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@(args => EditRow(bank))" @onclick:stopPropagation="true" title="Editer cette banque">
					</RadzenButton>
				</Template>
				<EditTemplate Context="bank">
					<RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@((args) => SaveRow(bank))">
					</RadzenButton>
					<RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" Class="my-1 ms-1" Click="@((args) => CancelEdit(bank))">
					</RadzenButton>
				</EditTemplate>
			</RadzenDataGridColumn>
			<RadzenDataGridColumn TItem="ViewModels.BankRow" Property="Entity.Code" Title="Code Banque" Width="220px" Filterable="false">
				<EditTemplate Context="bank">
					<RadzenTextBox @bind-Value="bank.Entity.Code" Style="width:100%" />
					<BrokenRuleMessage For="() => bank.Entity.Code" BrokenRuleList="brokenRules" />
				</EditTemplate>
			</RadzenDataGridColumn>
			<RadzenDataGridColumn TItem="ViewModels.BankRow" Title="Actif" Width="90px" Filterable="false">
				<Template Context="bank">
					@if (bank.Entity.Active)
					{
						<input type="radio" checked @onchange="@((args) => ChangeActiveBank(args, bank))" />
					}
					else
					{
						<input type="radio" @onchange="@((args) => ChangeActiveBank(args, bank))" />
					}
				</Template>
			</RadzenDataGridColumn>
			<RadzenDataGridColumn TItem="ViewModels.BankRow" Property="Entity.Label" Title="Libellé" Filterable="false">
				<EditTemplate Context="bank">
					<RadzenTextBox @bind-Value="bank.Entity.Label" Style="width:100%" />
					<BrokenRuleMessage For="() => bank.Entity.Label" BrokenRuleList="brokenRules" />
				</EditTemplate>
			</RadzenDataGridColumn>
		</Columns>
	</RadzenDataGrid>
</div>

