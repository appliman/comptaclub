@page "/bilans-previsionnels"

<PageTitle>Les budgets previsionnels</PageTitle>

<SectionContent SectionName="toolbar">

    <SuperButton Text="Ajouter"
                  Click="CreateForecastBudget"
                  Icon="fa-circle-plus"
                  Style="SuperButtonStyle.Success"
                  class="btn btn-primary m-1"
                  title="Creer un bilan prévisionnel" />

</SectionContent>

<SuperDataGrid RowHeight="55" @ref="grid" DisplaySelectionColumn="false" DisplayColumnVisibilityToggle="false"
    AllowFiltering="false"
    AllowSorting="true"
    AllowColumnResize="true"
    ItemsProvider="LoadItems"
    TItem="ViewModels.ForecastBudgetRow"
    SelectionMode="SuperDataGridSelectionMode.None"
    DisplayRowNumberColumn="true"
    Height="500px" ActionsWidth="70">
        <ActionsTemplate Context="data">
            <SuperButton Icon="fa-trash" Style="SuperButtonStyle.Warning"  Size="SuperButtonSize.Default" Click="@(args => DeleteRow(data.Entity))" @onclick:stopPropagation="true" title="Supprimer ce budget prévisionnel">
            </SuperButton>
        </ActionsTemplate>
        <ChildContent>
        <DataGridColumn TItem="ViewModels.ForecastBudgetRow" Property="Name" Title="Nom" Filterable="false" Width="200px">
            <Template Context="data">
                <a href="/bilan-previsionnel/@data.Id">@data.Entity.Name</a>
            </Template>
        </DataGridColumn>
        <DataGridColumn TItem="ViewModels.ForecastBudgetRow" Property="Description" Title="Description" Filterable="false">
            <Template Context="data">
                @data.Entity.Description
            </Template>
        </DataGridColumn>
        <DataGridColumn TItem="ViewModels.ForecastBudgetRow" Property="CreationDate" Title="Date" Filterable="false" Width="150px">
            <Template Context="data">
                <DateIdLabel Value="data.Entity.CreationDate"/>
            </Template>
        </DataGridColumn>
        <DataGridColumn TItem="ViewModels.ForecastBudgetRow" Title="Crédit" Width="120px" Filterable="false">
            <Template Context="data">
                <PriceLabel Value="data.Entity.CreditTotal"/>
            </Template>
        </DataGridColumn>
        <DataGridColumn TItem="ViewModels.ForecastBudgetRow" Title="Débit" Width="120px" Filterable="false">
            <Template Context="data">
                <PriceLabel Value="data.Entity.DebitTotal" />
            </Template>
        </DataGridColumn>
        <DataGridColumn TItem="ViewModels.ForecastBudgetRow" Title="Résultat Net" Width="120px" Filterable="false">
            <Template Context="data">
                @{
                    var total = data.Entity.CreditTotal - data.Entity.DebitTotal;
                }
                <PriceLabel Value="@total" />
            </Template>
        </DataGridColumn>
        </ChildContent>
</SuperDataGrid>
