@page "/utilisateurs"

<PageTitle>Liste des utilisateurs</PageTitle>

<SectionContent SectionName="toolbar">

    <SuperButton Text="Ajouter"
                  Click="InsertRow"
                  Icon="fa-user-plus"
                  Style="SuperButtonStyle.Success"
                  class="btn btn-primary m-1"
                  title="Ajouter un utilisateur" />

</SectionContent>

<SuperDataGrid @ref="grid"
                AllowFiltering="true"
                AllowSorting="true"
                AllowColumnResize="true"
                ItemsProvider="LoadItems"

                TItem="ViewModels.User"

                DisplayRowNumberColumn="false"
                Height="500px">

        <DataGridColumn TItem="ViewModels.User" Property="RowIndex" Title="#" Width="50px" Filterable="false"  >
        </DataGridColumn>
        <DataGridColumn TItem="ViewModels.User" Filterable="false" Sortable="false" TextAlign="SuperTextAlignment.Left" Width="100px">
            <Template Context="user">
                <SuperButton Icon="fa-pen" Style="SuperButtonStyle.Light"  Size="SuperButtonSize.Default" Click="@(args => EditRow(user))" title="Editer cet utilisateur">
                </SuperButton>
                <SuperButton Icon="fa-trash" Style="SuperButtonStyle.Warning"  Size="SuperButtonSize.Default" Click="@(args => DeleteRow(user))" title="Supprimer cet utilisateur">
                </SuperButton>
            </Template>
            <EditTemplate Context="user">
                <SuperButton Icon="fa-xmark" Style="SuperButtonStyle.Secondary"  Size="SuperButtonSize.Default" Click="@(args => CancelEdit(user))" title="Annuler">
                </SuperButton>
                <SuperButton Icon="fa-floppy-disk" Style="SuperButtonStyle.Success"  Size="SuperButtonSize.Default" Click="@(args => SaveRow(user))" title="Sauvegarder">
                </SuperButton>
            </EditTemplate>
        </DataGridColumn>
        <DataGridColumn TItem="ViewModels.User" Property="Name" Title="Nom" Width="250px" Filterable="false" >
            <EditTemplate Context="user">
                <input class="form-control w-100" @bind="user.Name" />
                <BrokenRuleMessage For="() => user.Name" BrokenRuleList="brokenRules" />
            </EditTemplate>
        </DataGridColumn>
        <DataGridColumn TItem="ViewModels.User" Property="Email" Title="Email" Filterable="false" FormatString="{0:dd/MM/yy}" >
            <EditTemplate Context="user">
                <input class="form-control w-100" @bind="user.Email" />
                <BrokenRuleMessage For="() => user.Email" BrokenRuleList="brokenRules" />
            </EditTemplate>
        </DataGridColumn>
        <DataGridColumn TItem="ViewModels.User" Property="CreationDate" Title="Date" Width="80px" Filterable="false" FormatString="{0:dd/MM/yy}" >
        </DataGridColumn>

</SuperDataGrid>

