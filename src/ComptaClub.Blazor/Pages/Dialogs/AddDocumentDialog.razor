<EditForm Model="Document">
	<ValidationSummary></ValidationSummary>
	<DataAnnotationsValidator />
	<CustomValidator @ref="customValidator"></CustomValidator>

	<SuperTabs SelectedIndexChanged="TabChanged">
		<Tabs>
			<TabItem Title="Fichier">
				<div class="row media-area mb-4">
					<div class="col-md-3 dialog-title">
						Fichier
					</div>
					<div class="col-md-9 file-drop-zone @HoverClass" @ondragenter="OnDragEnter" @ondragleave="OnDragLeave" @ondragover="OnDragEnter">
						<div class="row text-center">
							<small>vous pouvez glisser déposer une image dans cette zone</small>
						</div>
						<div class="row m-2">
							<InputFile class="form-control m-2" OnChange="OnInputFileChange"></InputFile>
						</div>
					</div>
				</div>

				<div class="row mb-3">
					<div class="col-md-3 dialog-title">
						Description du fichier
					</div>
					<div class="col-md-9">
						<InputText @bind-Value="@Document.Description" MaxLength="100" class="form-control w-100" />
						<ValidationMessage For="() => Document.Description" />
					</div>
				</div>
				<div class="row media-area mb-4">
					<div class="col-md-3 dialog-title">
						Taille
					</div>
					<div class="col-md-9">
						<FileSizeLabel FileSize="@Document.Size" />
					</div>
				</div>
			</TabItem>
			<TabItem Title="Photo">
				@if (!string.IsNullOrWhiteSpace(frameUri))
				{
					<img src="@frameUri" class="img-thumbnail mb-1 w-100 h-100" />
					<button class="btn btn-primary mb-3" @onclick="StartCamera">Activer la caméra</button>
				}
				else
				{
					<video id="videoFeed" class="w-100 h-100" />
					<button class="btn btn-primary mb-3" @onclick="CaptureFrame">Prendre une photo</button>
				}
				<canvas class="d-none" id="currentFrame" height="720" width="1280" />
			</TabItem>
		</Tabs>
	</SuperTabs>
</EditForm>

<div class="row mt-2 dialog-btns justify-content-end">
	<div class="col-auto">
		<SuperButton Style="SuperButtonStyle.Info" Icon="fa-xmark" Text="Annuler" Click="CloseDialog" />
	</div>
	<div class="col-auto">
		<SuperButton type="submit" Icon="fa-circle-plus" Text="Ajouter" Click="@Select" />
	</div>
</div>


