@if (panel == "grid")
{
	<SuperDataGrid RowHeight="55" @ref="grid" DisplaySelectionColumn="false" DisplayColumnVisibilityToggle="false" AllowFiltering="true" AllowSorting="true" AllowColumnResize="true" ItemsProvider="LoadItems" TItem="ViewModels.Document" SelectionMode="SuperDataGridSelectionMode.Multiple" SelectionChanged="OnSelectionChanged" DisplayRowNumberColumn="true" Height="400px">
    <DataGridColumn TItem="ViewModels.Document" Property="FileName" Title="Fichier" Width="120px" Filterable="true" />
    <DataGridColumn TItem="ViewModels.Document" Property="Description" Title="Description" Filterable="true" />
</SuperDataGrid>
}
else if (panel == "upload")
{
	<EditForm Model="document">
		<ValidationSummary></ValidationSummary>
		<DataAnnotationsValidator />
		<CustomValidator @ref="customValidator"></CustomValidator>

		<div class="row media-area mb-4">
			<div class="col-md-3 dialog-title">
				Fichier
			</div>
			<div class="col-md-9 file-drop-zone @HoverClass" @ref="fileDropContainer" @ondragenter="OnDragEnter" @ondragleave="OnDragLeave" @ondragover="OnDragEnter">
				<div class="row text-center">
					<small>vous pouvez glisser déposer une image dans cette zone</small>
				</div>
				<div class="row m-2">
					<InputFile class="form-control m-2" OnChange="OnInputFileChange"></InputFile>
				</div>
			</div>
		</div>

		<div class="row mb-3">
			<div class="col-md-3 dialog-title">
				Description du fichier
			</div>
			<div class="col-md-9">
				<InputText @bind-Value="@document!.Description" MaxLength="100" class="form-control w-100" />
				<ValidationMessage For="() => document.Description" />
			</div>
		</div>
		<div class="row media-area mb-4">
			<div class="col-md-3 dialog-title">
				Taille
			</div>
			<div class="col-md-9">
				<FileSizeLabel FileSize="@document.Size" />
			</div>
		</div>
	</EditForm>
}

<div class="row mt-2 dialog-btns justify-content-end">
	<div class="col-auto">
		<SuperButton Style="SuperButtonStyle.Light" Icon="fa-xmark" Text="Annuler" Click="@((args) => DialogService.Close())" />
	</div>
	<div class="col-auto">
		<SuperButton Style="SuperButtonStyle.Info" Icon="fa-file-circle-plus" Text="Ajouter" Click="Upload" />
	</div>
	<div class="col-auto">
		<SuperButton type="submit" Icon="fa-paperclip" Text="Associer" Click="@Select" />
	</div>
</div>
