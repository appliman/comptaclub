<SuperDataGrid RowHeight="55" @ref="grid" DisplaySelectionColumn="false" DisplayColumnVisibilityToggle="false"
                AllowFiltering="false"
                AllowSorting="true"
                AllowColumnResize="false"
                ItemsProvider="LoadDatas"

                TItem="ViewModels.Exercice"



                SelectionMode="SuperDataGridSelectionMode.Single" DisplayRowNumberColumn="true"
                SelectionChanged="OnSelectionChanged"
                Height="400px">

        <DataGridColumn TItem="ViewModels.Exercice" Property="Code" Title="Code">
        </DataGridColumn>
        <DataGridColumn TItem="ViewModels.Exercice" Property="Label" Title="Description" Width="160px">
        </DataGridColumn>

</SuperDataGrid>

<div class="row mt-2 dialog-btns justify-content-end">
    <div class="col-auto">
        <SuperButton Style="SuperButtonStyle.Info" Icon="fa-xmark" Text="Annuler" Click="@((args) => DialogService.Close())" />
    </div>
    <div class="col-auto">
        <SuperButton type="submit" Icon="fa-circle-plus" Text="Creer" Click="@Select" Disabled="@(selectedRow?.Count != 1)" />
    </div>
</div>
