<SuperDataGrid @ref="grid" AllowFiltering="false" AllowSorting="false" AllowColumnResize="true" Hierarchical="true" HierarchyKeySelector="@(account => account.Id)" ItemsProvider="LoadItems" TItem="ViewModels.Account" SelectionMode="SuperDataGridSelectionMode.Single" SelectionChanged="OnSelectionChanged" DisplayRowNumberColumn="false" Height="500px">
    <DataGridColumn TItem="ViewModels.Account" Property="Code" Title="Code Compta" Width="180px" Filterable="false" />
    <DataGridColumn TItem="ViewModels.Account" Property="Label" Title="Libellé du code compta" Filterable="false" />
</SuperDataGrid>

<div class="row mt-2 dialog-btns justify-content-end">
    <div class="col-auto">
        <SuperButton Style="SuperButtonStyle.Light" Icon="fa-xmark" Text="Annuler" Click="@((args) => DialogService.Close())" />
    </div>
    <div class="col-auto">
        <SuperButton type="submit" Icon="fa-circle-plus" Text="Selectionner" Click="@Select" Disabled="@(selectedRow is null)" />
    </div>
</div>


