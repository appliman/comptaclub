<SuperDataGrid @ref="grid" AllowFiltering="true" AllowSorting="true" AllowColumnResize="true" ItemsProvider="LoadItems" TItem="ViewModels.MemberRow" SelectionMode="SuperDataGridSelectionMode.Single" SelectionChanged="OnSelectionChanged" DisplayRowNumberColumn="false" Height="400px">
    <DataGridColumn TItem="ViewModels.MemberRow" Property="RowIndex" Title="#" Width="30px" Filterable="false" />
    <DataGridColumn TItem="ViewModels.MemberRow" Property="Entity.Name" Title="Nom" Width="120px" Filterable="true" />
    <DataGridColumn TItem="ViewModels.MemberRow" Property="Entity.Email" Title="Email" Width="100px" Filterable="false" />
</SuperDataGrid>

<div class="row mt-2 dialog-btns justify-content-end">
    <div class="col-auto">
        <SuperButton Style="SuperButtonStyle.Info" Icon="fa-xmark" Text="Annuler" Click="@((args) => DialogService.Close())" />
    </div>
    <div class="col-auto">
        <SuperButton type="submit" Icon="fa-user-plus" Text="Associer" Click="@Select" Disabled="@(selectedMembers?.Count != 1)" />
    </div>
</div>



