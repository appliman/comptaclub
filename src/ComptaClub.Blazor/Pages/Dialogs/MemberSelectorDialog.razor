<RadzenDataGrid @ref="grid"
                AllowFiltering="true"
                AllowSorting="true"
                AllowColumnResize="true"
                Data="@memberList"
                LoadData="LoadDatas"
                TItem="ViewModels.MemberRow"
                ColumnWidth="100px"
                GridLines="DataGridGridLines.Both"
                FilterMode="FilterMode.Simple"
                SelectionMode="DataGridSelectionMode.Single"
                @bind-Value="@selectedMembers"
                Style="height:400px;">
    <Columns>
        <RadzenDataGridColumn TItem="ViewModels.MemberRow" Property="RowIndex" Title="#" Width="30px" Filterable="false" SortOrder="SortOrder.Ascending" >
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ViewModels.MemberRow" Property="Name" Title="Nom" Width="120px" Filterable="true" >
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ViewModels.MemberRow" Property="Email" Title="Email" Width="100px" Filterable="false">
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

<div class="row mt-2 dialog-btns justify-content-end">
    <div class="col-auto">
        <RadzenButton ButtonStyle="ButtonStyle.Info" Icon="cancel" Text="Annuler" Click="@((args) => DialogService.Close())" />
    </div>
    <div class="col-auto">
        <RadzenButton ButtonType="ButtonType.Submit" Icon="person_add" Text="Associer" Click="@Select" />
    </div>
</div>



