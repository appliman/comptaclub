<SuperDataGrid @ref="grid"
                AllowFiltering="false"
                AllowSorting="true"
                AllowColumnResize="false"
                ItemsProvider="LoadDatas"
                TItem="ViewModels.IncomeStatement"
                SelectionMode="SuperDataGridSelectionMode.Single"
                DisplayRowNumberColumn="false"
                SelectionChanged="OnSelectionChanged"
                Height="400px">

        <DataGridColumn TItem="ViewModels.IncomeStatement" Property="Description" Title="Description">
        </DataGridColumn>

</SuperDataGrid>

<div class="row mt-2 dialog-btns justify-content-end">
    <div class="col-auto">
        <SuperButton Style="SuperButtonStyle.Info" Icon="fa-xmark" Text="Annuler" Click="@((args) => DialogService.Close())" />
    </div>
    <div class="col-auto">
        <SuperButton type="submit" Icon="fa-circle-plus" Text="Creer" Click="@Select" Disabled="@(selectedRow?.Count != 1)" />
    </div>
</div>
