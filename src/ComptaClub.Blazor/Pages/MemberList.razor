@page "/membres"

<PageTitle>Liste des membres</PageTitle>

<SectionContent SectionName="toolbar">

	<SuperButton Text="Importer"
				  Click="ImportFile"
				  Icon="fa-file-arrow-up"
				  Style="SuperButtonStyle.Success"
				  class="btn btn-primary m-1"
				  title="Importer à partir d'un fichier excel" />

</SectionContent>

<div style="height:100%">
	<SuperDataGrid RowHeight="55" @ref="grid" DisplaySelectionColumn="false" DisplayColumnVisibilityToggle="false"
					AllowFiltering="true"
					AllowSorting="true"
					AllowColumnResize="true"
					ItemsProvider="LoadItems"

					TItem="ViewModels.MemberRow"


					DisplayRowNumberColumn="true"
					SelectionMode="SuperDataGridSelectionMode.Multiple"
					SelectionChanged="OnSelectionChanged"
					Height="500px" ActionsWidth="120">
			<ActionsTemplate Context="item">
				@if (grid.IsRowInEditMode(item))
				{
					<SuperButton Icon="fa-check" Style="SuperButtonStyle.Success"  Size="SuperButtonSize.Default" Click="@((args) => SaveRow(item))">
					</SuperButton>
					<SuperButton Icon="fa-xmark" Style="SuperButtonStyle.Light"  Size="SuperButtonSize.Default" Class="my-1 ms-1" Click="@((args) => CancelEdit(item))">
					</SuperButton>
				}
				else
				{
					<SuperButton Icon="fa-trash" Style="SuperButtonStyle.Warning"  Size="SuperButtonSize.Default" Click="@(args => DeleteRow(item))" title="Supprimer ce membre">
					</SuperButton>
					<SuperButton Icon="fa-pen" Style="SuperButtonStyle.Light"  Size="SuperButtonSize.Default" Click="@(args => EditRow(item))" title="Editer ce membre">
					</SuperButton>
				}
			</ActionsTemplate>
			<ChildContent>
			<DataGridColumn TItem="ViewModels.MemberRow" Property="Entity.Name" Title="Nom" Sortable="true" Filterable="true" Width="180px" >
				<Template Context="item">@item.Entity.Name</Template>
				<EditTemplate Context="item">
					<input class="form-control w-100" @bind="item.Entity.Name" />
					<BrokenRuleMessage For="() => item.Entity.Name" BrokenRuleList="brokenRules" />
				</EditTemplate>
			</DataGridColumn>
			<DataGridColumn TItem="ViewModels.MemberRow" Property="Entity.Email" Title="Email" Width="150px" Sortable="true" Filterable="true" >
				<Template Context="item">@item.Entity.Email</Template>
				<EditTemplate Context="item">
					<input class="form-control w-100" @bind="item.Entity.Email" />
					<BrokenRuleMessage For="() => item.Entity.Email" BrokenRuleList="brokenRules" />
				</EditTemplate>
			</DataGridColumn>
			<DataGridColumn TItem="ViewModels.MemberRow" Property="Entity.LicenseNumber" Title="Licence" Sortable="true" Filterable="true" Width="200px" >
				<Template Context="item">@item.Entity.LicenseNumber</Template>
				<EditTemplate Context="item">
					<input class="form-control w-100" @bind="item.Entity.LicenseNumber" />
					<BrokenRuleMessage For="() => item.Entity.LicenseNumber" BrokenRuleList="brokenRules" />
				</EditTemplate>
			</DataGridColumn>
			<DataGridColumn TItem="ViewModels.MemberRow" Property="Entity.LicenseTypeName" Title="Type" Width="180px" Sortable="true" Filterable="true" >
				<Template Context="item">@item.Entity.LicenseTypeName</Template>
			</DataGridColumn>
			<DataGridColumn TItem="ViewModels.MemberRow" Property="Entity.Amount" Title="Réglé" Width="80px" Filterable="false" >
				<Template Context="data">
					<PriceLabel Value="data.Amount" />
				</Template>
			</DataGridColumn>
			<DataGridColumn TItem="ViewModels.MemberRow" Property="State" Title="Etat" Width="110px" Filterable="true" >
				<FilterTemplate>
					<SuperNullableEnumDropdownFilterColumn @bind-Value="filter.MemberState" ApplyFilter="ApplyFilter" />
				</FilterTemplate>
				<Template Context="item">
					<EnumLabel @bind-Value="item.Entity.State" />
				</Template>
				<EditTemplate Context="item">
					<SuperEnumInputSelect @bind-Value="item.Entity.State" />
				</EditTemplate>
			</DataGridColumn>
			<DataGridColumn TItem="ViewModels.MemberRow" Property="LastUpdate" Title="M.a.j." Width="120px" Filterable="false" >
				<Template Context="data">
					<DateIdLabel Value="data.Entity.LastUpdate" />
				</Template>
			</DataGridColumn>
			</ChildContent>
	</SuperDataGrid>
</div>
