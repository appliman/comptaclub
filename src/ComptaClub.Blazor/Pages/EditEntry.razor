@page "/ecriture/ajout"
@page "/ecriture/edition/{EntryId:guid}"

<PageTitle>Exercice</PageTitle>

<div class="panel-body">
	<EditForm Model="entry" OnValidSubmit="ValidateAndSave">
		<ValidationSummary></ValidationSummary>
		<DataAnnotationsValidator />
		<CustomValidator @ref="customValidator"></CustomValidator>
		<div class="row">
			<SuperInputText @bind-Value="entry.PartNumber" PlaceHoder="Code" Required="true" Label="N° Pièce :" />
			<SuperInputText @bind-Value="entry.Label" PlaceHoder="Libellé" Required="true" Label="Libellé :" />
		</div>
		<div class="form-group" style="margin-top:10px">
			<button type="submit" class="btn btn-primary">Enregistrer</button>
		</div>
	</EditForm>
</div>


