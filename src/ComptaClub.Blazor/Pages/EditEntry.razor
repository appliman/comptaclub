@page "/ecriture/ajout/{direction}"
@page "/ecriture/edition/{EntryId:guid}"

<PageTitle>Edition d'une ecriture</PageTitle>

<nav aria-label="breadcrumb">
	<ol class="breadcrumb">
		<li class="breadcrumb-item"><a href="#">Accueil</a></li>
		<li class="breadcrumb-item"><a href="@GetEntriesUrl()">Ecritures</a></li>
		<li class="breadcrumb-item active" aria-current="page">@entry.Label</li>
	</ol>
</nav>

<SectionContent SectionName="toolbar">

	<RadzenButton Text="Sauvegarder"
				  Click="ValidateAndSave"
				  Icon="save"
				  ButtonStyle="ButtonStyle.Success"
				  class="btn btn-primary m-1" />

	@if (selectedTabIndex == 2)
	{
		<RadzenButton Text="Associer"
					  Click="associatedDocuments.InsertRow"
					  Icon="upload_file"
					  ButtonStyle="ButtonStyle.Success"
					  class="btn btn-primary m-1"
					  title="Associer un document à cette écriture" />
	}

</SectionContent>

<RadzenTabs TabPosition="TabPosition.Left" SelectedIndexChanged="RefreshToolbar" @ref="tabs">
	<Tabs>
		<RadzenTabsItem Text="Informations" Icon="feed">
			<EditForm Model="entry" OnValidSubmit="ValidateAndSave">
				<ValidationSummary></ValidationSummary>
				<DataAnnotationsValidator />
				<CustomValidator @ref="customValidator"></CustomValidator>
				<div class="row">
					<SuperInputDayId class="w-25" @bind-DayId="entry.CreationDate" PlaceHoder="Date" Required="true" Label="Date :" />
					<SuperInputText @bind-Value="entry.PartNumber" PlaceHoder="Code" Required="true" Label="N° Pièce :" />
					<SuperInputText @bind-Value="entry.Label" PlaceHoder="Libellé" Required="true" Label="Libellé :" />
					<SuperInputSelect @bind-Value="entry.BankId" ItemList="@bankOptionList" Required="true" Label="Banque :" />
					<SuperInputSelect @bind-Value="entry.AccountId" ItemList="@accountOptionList" Required="true" Label="Compte :" />
					<SuperEnumInputSelect @bind-Value="entry.PaymentType" Required="true" Label="Mode de règlement :" />
					<SuperInputCurrency @bind-Value="entry.Amount" PlaceHoder="Montant" Label="Montant :" style="width:200px;" />
					<SuperInputArea @bind-Value="entry.ExtraInfos" PlaceHoder="Informations supplémentaires" Label="Informations supplémentaires :" />
				</div>
			</EditForm>
		</RadzenTabsItem>
		<RadzenTabsItem Text="Membres" Icon="group_add">
			<h4>Membres associés à l'écriture :</h4>
			<AssociatedMemberByEntry @ref="associatedMembers" EntryId="EntryId" />
		</RadzenTabsItem>
		<RadzenTabsItem Text="documents" Icon="attach_file">
			<h4>Documents associés à l'écriture</h4>
			<DocumentListByEntity MetaEntity="MetaEntity.Entry" EntityId="EntryId.GetValueOrDefault(Guid.Empty)" @ref="associatedDocuments"/>
		</RadzenTabsItem>
	</Tabs>
</RadzenTabs>

