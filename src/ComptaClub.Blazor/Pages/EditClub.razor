@page "/club"

<PageTitle>Club</PageTitle>

<SectionContent SectionName="toolbar">

	<SuperButton Text="Sauvegarder"
				  Click="ValidateAndSave"
				  Icon="fa-floppy-disk"
				  Style="SuperButtonStyle.Success"
				  class="btn btn-primary m-1" />

</SectionContent>

<div class="panel-body">
	<EditForm Model="club" OnValidSubmit="ValidateAndSave">
		<ValidationSummary></ValidationSummary>
		<DataAnnotationsValidator />
		<CustomValidator @ref="customValidator"></CustomValidator>
		<div class="row">
			<SuperInputText @bind-Value="club.Name" PlaceHoder="Nom" Required="true" Label="Nom :" />
			<SuperInputText @bind-Value="club.Object" PlaceHoder="Objet" Label="Objet :" />
			<hr />
			<small>Taille du logo 180px / 180px</small>
			<InputFile class="form-control" OnChange="@OnInputFileChange" />
			@if (club.LogoBase64String is not null)
			{
				<img class="img-thumbnail m-3" style="width:180px; height:180px;" width="180" height="180" src="data:@club.LogoContentType;base64,@club.LogoBase64String">
			}
			<hr />
			<SuperInputArea @bind-Value="club.Address" PlaceHoder="Adresse" Label="Adresse :" />
			<SuperInputText @bind-Value="club.SiretNumber" PlaceHoder="N°Siret" Label="N°Siret :" />
			<SuperInputText @bind-Value="club.RNA" PlaceHoder="N°RNA" Label="N°Rna :" />
			<SuperInputText @bind-Value="club.Email" PlaceHoder="contact@exemple.com" Label="Email :" />
			<SuperInputText @bind-Value="club.ContactName" PlaceHoder="contact" Label="Nom d'envoi :" />
			<SuperInputText @bind-Value="club.WebSite" PlaceHoder="https://www.exemple.com" Label="Site Web :" />
			<SuperInputText @bind-Value="club.PhoneNumber" PlaceHoder="https://www.exemple.com" Label="N°Téléphone :" />
		</div>
	</EditForm>
    <section class="mt-4 pt-3 border-top" aria-labelledby="database-backup-title">
        <h2 id="database-backup-title" class="h5">Sauvegarde de la base de données</h2>
        @if (Settings.DatabaseProvider.Equals("Sqlite", StringComparison.OrdinalIgnoreCase))
        {
            <p>Téléchargez une sauvegarde complète au format ZIP protégé. Le mot de passe sera envoyé à l'adresse email de votre compte. Le lien reste valable 24 heures.</p>
            <SuperButton Text="Préparer la sauvegarde" BusyText="Préparation en cours…" Icon="fa-file-zipper"
                         Click="CreateDatabaseBackup" Disabled="_creatingBackup" Style="SuperButtonStyle.Primary" />
            @if (_backupUrl is not null)
            {
                <p class="mt-3">Le mot de passe a été envoyé par email.</p>
                <SuperLinkButton Text="Télécharger la sauvegarde ZIP" Href="@_backupUrl" Icon="fa-download" data-enhance-nav="false" />
            }
        }
        else
        {
            <p>Le téléchargement de la base de données est disponible uniquement avec SQLite.</p>
        }
    </section>
</div>



